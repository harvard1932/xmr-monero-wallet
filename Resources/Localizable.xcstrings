          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez chaque destination, montant et frais avant de signer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हस्ताक्षर करने से पहले प्रत्येक गंतव्य, राशि और शुल्क की जाँच करें।"
