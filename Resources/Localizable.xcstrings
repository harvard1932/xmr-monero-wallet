    "Free and open source. Create a wallet on this iPhone or restore one from a backup.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني ومفتوح المصدر. أنشئ محفظة على هذا الـ iPhone أو استعد محفظة من نسخة احتياطية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যে ও মুক্ত উৎসের। এই iPhone-এ একটি ওয়ালেট তৈরি করুন অথবা ব্যাকআপ থেকে ফিরিয়ে আনুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos und quelloffen. Erstelle eine Wallet auf diesem iPhone oder stelle eine Wallet aus einer Sicherung wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis y de código abierto. Crea una cartera en este iPhone o restaura una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit et open source. Créez un portefeuille sur cet iPhone ou restaurez-en un à partir d’une sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त और ओपन सोर्स। इस iPhone पर वॉलेट बनाएँ या बैकअप से वॉलेट बहाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis dan bersumber terbuka. Buat dompet di iPhone ini atau pulihkan dompet dari cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis e open source. Crea un portafoglio su questo iPhone o ripristinane uno da una copia di backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料で使えるオープンソースのウォレットです。このiPhoneでウォレットを作成するか、バックアップから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 오픈 소스 지갑입니다. 이 iPhone에서 지갑을 만들거나 백업에서 복원하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma dan bersumber terbuka. Cipta dompet pada iPhone ini atau pulihkan dompet daripada sandaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en open source. Maak een wallet aan op deze iPhone of herstel een wallet vanuit een back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatna aplikacja o otwartym kodzie źródłowym. Utwórz portfel na tym iPhonie lub odtwórz go z kopii zapasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuito e de código aberto. Crie uma carteira neste iPhone ou restaure uma carteira a partir de uma cópia de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно и с открытым исходным кодом. Создайте кошелёк на этом iPhone или восстановите его из резервной копии."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bure na ina msimbo wazi. Fungua pochi kwenye iPhone hii au urejeshe pochi kutoka kwenye nakala ya akiba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรีและเป็นโอเพนซอร์ส สร้างกระเป๋าบน iPhone เครื่องนี้หรือกู้คืนจากข้อมูลสำรอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve açık kaynaklıdır. Bu iPhone’da bir cüzdan oluşturun veya yedekten geri yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí và mã nguồn mở. Tạo ví trên iPhone này hoặc khôi phục ví từ bản sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费且开源。你可以在这部 iPhone 上创建钱包，也可以从备份恢复钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費且開放原始碼。你可以在這部 iPhone 上建立錢包，也可以從備份還原錢包。"
          }
        }
      }
    },
