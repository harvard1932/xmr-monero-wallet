    "Wallet files are encrypted on this iPhone. The unlock key is protected by the device Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُشفّر ملفات المحفظة على هذا الـ iPhone. تحمي سلسلة مفاتيح الجهاز مفتاح فتح القفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই iPhone-এ ওয়ালেটের ফাইল এনক্রিপ্ট করা থাকে। ডিভাইসের Keychain আনলক কী সুরক্ষিত রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Wallet-Dateien sind auf diesem iPhone verschlüsselt. Der Geräteschlüsselbund schützt den Entsperrschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los archivos de la cartera se cifran en este iPhone. El llavero del dispositivo protege la clave de desbloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fichiers du portefeuille sont chiffrés sur cet iPhone. Le trousseau de l’appareil protège la clé de déverrouillage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस iPhone पर वॉलेट की फ़ाइलें एन्क्रिप्ट की जाती हैं। डिवाइस का Keychain अनलॉक कुंजी की सुरक्षा करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "File dompet dienkripsi di iPhone ini. Rantai Kunci perangkat melindungi kunci pembuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I file del portafoglio sono cifrati su questo iPhone. Il portachiavi del dispositivo protegge la chiave di sblocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットファイルはこのiPhone上で暗号化されます。解除鍵は端末のキーチェーンで保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지갑 파일은 이 iPhone에서 암호화됩니다. 기기의 키체인이 잠금 해제 키를 보호합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fail dompet disulitkan pada iPhone ini. Rantai Kunci peranti melindungi kunci pembuka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De walletbestanden zijn op deze iPhone versleuteld. De sleutelhanger van het apparaat beschermt de ontgrendelingssleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pliki portfela są szyfrowane na tym iPhonie. Pęk kluczy urządzenia chroni klucz odblokowujący."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os arquivos da carteira são criptografados neste iPhone. O chaveiro do dispositivo protege a chave de desbloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файлы кошелька на этом iPhone зашифрованы. Ключ разблокировки защищён связкой ключей устройства."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plånboksfilerna krypteras på denna iPhone. Enhetens nyckelring skyddar upplåsningsnyckeln."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faili za pochi husimbwa kwa njia fiche kwenye iPhone hii. Keychain ya kifaa hulinda ufunguo wa kufungua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์กระเป๋าเงินได้รับการเข้ารหัสบน iPhone เครื่องนี้ พวงกุญแจของอุปกรณ์ปกป้องกุญแจปลดล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cüzdan dosyaları bu iPhone’da şifrelenir. Kilit açma anahtarını cihazın Anahtar Zinciri korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các tệp ví được mã hóa trên iPhone này. Chuỗi khóa của thiết bị bảo vệ khóa mở ví."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "钱包文件在此 iPhone 上加密。设备钥匙串会保护解锁密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "錢包檔案會在此 iPhone 上加密。裝置鑰匙圈會保護解鎖金鑰。"
          }
        }
      }
    },
    "Wallet files could not be saved. Unlock and check your wallet before continuing.": {
