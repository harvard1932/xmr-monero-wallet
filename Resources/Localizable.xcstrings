    "Offline wallets can create addresses and review saved activity. Choose a node to scan or send payments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن للمحافظ غير المتصلة بالإنترنت إنشاء عناوين ومراجعة النشاط المحفوظ. اختر عقدة لمسح أو إرسال المدفوعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অফলাইন ওয়ালেট ঠিকানা তৈরি করতে পারে এবং সংরক্ষিত কার্যকলাপ পর্যালোচনা করতে পারে। স্ক্যান বা পেমেন্ট পাঠাতে একটি নোড চয়ন করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offline-Wallets können Adressen erstellen und gespeicherte Aktivitäten überprüfen. Wählen Sie einen Knoten zum Scannen oder Senden von Zahlungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las billeteras sin conexión pueden crear direcciones y revisar la actividad guardada. Elija un nodo para escanear o enviar pagos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les portefeuilles hors ligne peuvent créer des adresses et consulter les activités enregistrées. Choisissez un nœud pour numériser ou envoyer des paiements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऑफ़लाइन वॉलेट पते बना सकते हैं और सहेजी गई गतिविधि की समीक्षा कर सकते हैं। भुगतान स्कैन करने या भेजने के लिए एक नोड चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dompet offline dapat membuat alamat dan meninjau aktivitas yang disimpan. Pilih node untuk memindai atau mengirim pembayaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I portafogli offline possono creare indirizzi e rivedere l'attività salvata. Scegli un nodo per scansionare o inviare pagamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインウォレットではアドレスを作成し、保存されたアクティビティを確認できます。支払いをスキャンまたは送信するノードを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인 지갑은 주소를 생성하고 저장된 활동을 검토할 수 있습니다. 결제를 스캔하거나 보낼 노드를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dompet luar talian boleh membuat alamat dan menyemak aktiviti yang disimpan. Pilih nod untuk mengimbas atau menghantar pembayaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offline portemonnees kunnen adressen aanmaken en opgeslagen activiteiten bekijken. Kies een knooppunt om betalingen te scannen of te verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Portfele offline mogą tworzyć adresy i przeglądać zapisaną aktywność. Wybierz węzeł do skanowania lub wysyłania płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carteiras offline podem criar endereços e revisar atividades salvas. Escolha um nó para digitalizar ou enviar pagamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автономные кошельки могут создавать адреса и просматривать сохраненную активность. Выберите узел для сканирования или отправки платежей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offlineplånböcker kan skapa adresser och granska sparad aktivitet. Välj en nod för att skanna eller skicka betalningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wallet za nje ya mtandao zinaweza kuunda anwani na kukagua shughuli zilizohifadhiwa. Chagua nodi ya kuchanganua au kutuma malipo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กระเป๋าเงินออฟไลน์สามารถสร้างที่อยู่และตรวจสอบกิจกรรมที่บันทึกไว้ได้ เลือกโหนดที่จะสแกนหรือส่งการชำระเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrimdışı cüzdanlar adres oluşturabilir ve kaydedilen etkinlikleri inceleyebilir. Ödemeleri taramak veya göndermek için bir düğüm seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ví ngoại tuyến có thể tạo địa chỉ và xem lại hoạt động đã lưu. Chọn một nút để quét hoặc gửi thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "离线钱包可以创建地址并查看保存的活动。选择一个节点来扫描或发送付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線錢包可以建立地址並檢視已儲存的交易紀錄。請選擇節點以掃描區塊鏈或傳送付款。"
          }
        }
      }
    },
    "On your offline signer, open Cold signing and scan the unsigned transaction.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في موقع التوقيع غير المتصل بالإنترنت، افتح التوقيع البارد وقم بمسح المعاملة غير الموقعة ضوئيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অফলাইন স্বাক্ষরকারীতে, কোল্ড সাইনিং খুলুন এবং স্বাক্ষরবিহীন লেনদেন স্ক্যান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffnen Sie auf Ihrem Offline-Unterzeichner die Kaltsignierung und scannen Sie die nicht signierte Transaktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En su firmante fuera de línea, abra la firma en frío y escanee la transacción sin firmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur votre signataire hors ligne, ouvrez la signature à froid et scannez la transaction non signée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने ऑफ़लाइन हस्ताक्षरकर्ता पर, कोल्ड साइनिंग खोलें और अहस्ताक्षरित लेनदेन को स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada penandatangan offline Anda, buka Penandatanganan dingin dan pindai transaksi yang tidak ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sul firmatario offline, apri Firma a freddo ed esegui la scansione della transazione non firmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフライン署名者でコールド署名を開き、未署名のトランザクションをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인 서명자에서 콜드 서명을 열고 서명되지 않은 거래를 스캔합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pada penandatangan luar talian anda, buka Tandatangan Dingin dan imbas transaksi yang tidak ditandatangani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Koud ondertekenen op uw offline ondertekenaar en scan de niet-ondertekende transactie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na osobie podpisującej w trybie offline otwórz podpisywanie na zimno i zeskanuj niepodpisaną transakcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No seu assinante offline, abra Cold Signing e verifique a transação não assinada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На вашей автономной подписывающей стороне откройте холодную подпись и отсканируйте неподписанную транзакцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna Cold signering på din offlinesignerare och skanna den osignerade transaktionen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kwenye sahihi yako ya nje ya mtandao, fungua Utiaji sahihi wa Baridi na uchanganue muamala ambao haujasainiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บนผู้ลงนามออฟไลน์ของคุณ ให้เปิด Cold Signing และสแกนธุรกรรมที่ไม่ได้ลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrimdışı imzalayanınızda Soğuk imzalamayı açın ve imzalanmamış işlemi tarayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trên người ký ngoại tuyến của bạn, hãy mở Ký nguội và quét giao dịch chưa được ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在离线签名器上，打开冷签名并扫描未签名的交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在離線簽署裝置上開啟「離線簽署」，然後掃描未簽署的交易。"
          }
        }
      }
    },
