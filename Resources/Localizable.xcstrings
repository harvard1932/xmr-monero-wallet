          "stringUnit": {
            "state": "needs_review",
            "value": "অনেক বেশি পিন প্রয়াস। এক মিনিট অপেক্ষা করুন বা iPhone পাসকোড দিয়ে আপনার পিন রিসেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zu viele PIN-Versuche. Warten Sie eine Minute oder setzen Sie Ihre PIN mit dem iPhone-Passcode zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demasiados intentos de PIN. Espere un minuto o restablezca su PIN con la contraseña del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trop de tentatives de code PIN. Attendez une minute ou réinitialisez votre code PIN avec le mot de passe de l'iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बहुत अधिक पिन प्रयास. एक मिनट रुकें या iPhone पासकोड से अपना पिन रीसेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terlalu banyak upaya PIN. Tunggu sebentar atau setel ulang PIN Anda dengan kode sandi iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Troppi tentativi di PIN. Attendi un minuto o reimposta il PIN con il passcode dell'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN の試行が多すぎます。しばらく待つか、iPhone のパスコードを使用して PIN をリセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN 시도 횟수가 너무 많습니다. 잠시 기다리거나 iPhone 비밀번호로 PIN을 재설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terlalu banyak percubaan PIN. Tunggu sebentar atau tetapkan semula PIN anda dengan kod laluan iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Te veel pincodepogingen. Wacht een minuut of reset uw pincode met de iPhone-toegangscode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zbyt wiele prób wprowadzenia kodu PIN. Poczekaj chwilę lub zresetuj kod PIN za pomocą hasła iPhone'a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muitas tentativas de PIN. Espere um minuto ou redefina seu PIN com a senha do iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Слишком много попыток ввода PIN-кода. Подождите минуту или сбросьте свой PIN-код с помощью пароля iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "För många PIN-försök. Vänta en minut eller återställ din PIN-kod med iPhone-lösenordet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Majaribio mengi sana ya PIN. Subiri kidogo au uweke upya PIN yako ukitumia nambari ya siri ya iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พยายามใช้ PIN มากเกินไป รอสักครู่หรือรีเซ็ต PIN ของคุณด้วยรหัสผ่าน iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çok fazla PIN denemesi yapıldı. Bir dakika bekleyin veya PIN'inizi iPhone parolasıyla sıfırlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quá nhiều lần thử mã PIN. Đợi một phút hoặc đặt lại mã PIN của bạn bằng mật mã iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN 码尝试次数过多。请稍等或使用 iPhone 密码重置您的 PIN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN 碼嘗試次數過多。請稍候或使用 iPhone 密碼重設您的 PIN。"
          }
        }
      }
    },
