    "Sync outputs and key images with the offline signer before building a payment in Send.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بمزامنة المخرجات والصور الرئيسية مع المُوقع غير المتصل بالإنترنت قبل إنشاء دفعة في إرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send এ অর্থপ্রদান করার আগে অফলাইন স্বাক্ষরকারীর সাথে আউটপুট এবং মূল চিত্রগুলি সিঙ্ক করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisieren Sie Ausgaben und Schlüsselbilder mit dem Offline-Unterzeichner, bevor Sie eine Zahlung in Send erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronice resultados e imágenes clave con el firmante fuera de línea antes de realizar un pago en Enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchronisez les sorties et les images clés avec le signataire hors ligne avant de créer un paiement dans Envoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सेंड में भुगतान करने से पहले आउटपुट और मुख्य छवियों को ऑफ़लाइन हस्ताक्षरकर्ता के साथ सिंक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinkronkan keluaran dan gambar utama dengan penandatangan offline sebelum melakukan pembayaran di Kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronizza gli output e le immagini chiave con il firmatario offline prima di creare un pagamento in Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send で支払いを構築する前に、出力とキー画像をオフライン署名者と同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Send에서 결제를 하기 전에 오프라인 서명자와 출력 및 주요 이미지를 동기화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segerakkan output dan imej utama dengan penandatangan luar talian sebelum membina pembayaran dalam Hantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synchroniseer uitvoer en sleutelafbeeldingen met de offline ondertekenaar voordat u een betaling in Verzenden opbouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zsynchronizuj wyniki i kluczowe obrazy z osobą podpisującą w trybie offline przed utworzeniem płatności w aplikacji Send."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sincronize resultados e imagens principais com o assinante off-line antes de criar um pagamento no Send."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхронизируйте выходные данные и изображения ключей с автономным подписывающим лицом, прежде чем создавать платеж в Send."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Synkronisera utdata och nyckelbilder med offlinesigneraren innan du bygger en betalning i Send."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sawazisha matokeo na picha muhimu na mtu aliyetia sahihi nje ya mtandao kabla ya kutuma malipo katika Tuma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ซิงค์เอาต์พุตและรูปภาพหลักกับผู้ลงนามออฟไลน์ก่อนสร้างการชำระเงินใน Send"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gönder'de bir ödeme oluşturmadan önce çıktıları ve anahtar görselleri çevrimdışı imzalayanla senkronize edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đồng bộ hóa đầu ra và hình ảnh chính với người ký ngoại tuyến trước khi thực hiện thanh toán trong Gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在发送中构建付款之前，与离线签名者同步输出和关键图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「傳送」頁面建立付款之前，請先與離線簽署裝置同步輸出和金鑰映像。"
          }
        }
      }
    },
