    "Independent developer preview. Monero network fees apply when you send XMR.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "معاينة المطور المستقل. يتم تطبيق رسوم شبكة Monero عند إرسال XMR."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "স্বাধীন বিকাশকারী পূর্বরূপ। আপনি যখন XMR পাঠান তখন Monero নেটওয়ার্ক ফি প্রযোজ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vorschau für unabhängige Entwickler. Beim Senden von XMR fallen Monero-Netzwerkgebühren an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vista previa para desarrolladores independientes. Se aplican tarifas de red de Monero cuando envías XMR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aperçu du développeur indépendant. Des frais de réseau Monero s'appliquent lorsque vous envoyez du XMR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वतंत्र डेवलपर पूर्वावलोकन. जब आप XMR भेजते हैं तो मोनेरो नेटवर्क शुल्क लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pratinjau pengembang independen. Biaya jaringan Monero berlaku saat Anda mengirim XMR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anteprima per sviluppatori indipendenti. Si applicano le commissioni della rete Monero quando invii XMR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "独立した開発者のプレビュー。 XMR を送信すると、Monero のネットワーク料金が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "독립 개발자 미리보기. XMR를 보낼 때 모네로 네트워크 수수료가 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pratonton pembangun bebas. Yuran rangkaian Monero dikenakan apabila anda menghantar XMR."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Preview van onafhankelijke ontwikkelaar. Er zijn Monero-netwerkkosten van toepassing wanneer u XMR verzendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niezależny podgląd programisty. Przy wysyłaniu XMR obowiązują opłaty sieciowe Monero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visualização do desenvolvedor independente. As taxas da rede Monero se aplicam quando você envia XMR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Независимый предварительный просмотр от разработчиков. При отправке XMR взимается сетевая комиссия Monero."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oberoende utvecklare förhandsvisning. Monero-nätverksavgifter tillkommer när du skickar XMR."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onyesho la kuchungulia la msanidi huru. Ada za mtandao wa Monero hutozwa unapotuma XMR."
          }
        },
        "th": {
          "stringUnit": {
