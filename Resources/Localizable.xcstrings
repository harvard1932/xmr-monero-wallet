    "Tor connections require the native onion transport.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتطلب اتصالات Tor نقل البصل الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "টর সংযোগের জন্য দেশীয় পেঁয়াজ পরিবহন প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor-Verbindungen erfordern den nativen Zwiebeltransport."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las conexiones Tor requieren el transporte de cebolla nativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les connexions Tor nécessitent le transport d’oignon natif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टोर कनेक्शन के लिए देशी प्याज परिवहन की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koneksi Tor memerlukan transportasi bawang asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le connessioni Tor richiedono il trasporto Onion nativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor 接続にはネイティブのオニオン トランスポートが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor 연결에는 기본 양파 전송이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungan Tor memerlukan pengangkutan bawang asli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor-verbindingen vereisen het inheemse uientransport."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połączenia Tor wymagają natywnego transportu cebuli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As conexões Tor requerem o transporte cebola nativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для соединений Tor требуется собственный луковый транспорт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor-anslutningar kräver den inhemska löktransporten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miunganisho ya Tor inahitaji usafiri wa kitunguu asili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อ Tor จำเป็นต้องมีการขนส่งหัวหอมดั้งเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor bağlantıları yerel soğan aktarımını gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối Tor yêu cầu vận chuyển củ hành bản địa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
