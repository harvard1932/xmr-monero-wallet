        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "देशी इंजन को प्रॉक्सी के माध्यम से स्थानीय सुरक्षित परिवहन या टोर वी3 प्याज नोड की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesin asli memerlukan transportasi aman lokal atau node bawang Tor v3 melalui proxy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il motore nativo richiede un trasporto locale sicuro o un nodo Onion Tor v3 tramite un proxy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネイティブ エンジンには、ローカルの安全なトランスポート、またはプロキシ経由の Tor v3 オニオン ノードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기본 엔진에는 프록시를 통한 로컬 보안 전송 또는 Tor v3 양파 노드가 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enjin asli memerlukan pengangkutan selamat tempatan atau nod bawang Tor v3 melalui proksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De native engine vereist een lokaal beveiligd transport of een Tor v3-uienknooppunt via een proxy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Natywny silnik wymaga lokalnego bezpiecznego transportu lub węzła cebulowego Tor v3 za pośrednictwem serwera proxy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O mecanismo nativo requer um transporte local seguro ou um nó cebola Tor v3 por meio de um proxy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Собственный движок требует локального безопасного транспорта или лукового узла Tor v3 через прокси."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den inbyggda motorn kräver en lokal säker transport eller en Tor v3 löknod via en proxy."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Injini asili inahitaji usafiri salama wa ndani au nodi ya vitunguu ya Tor v3 kupitia proksi."
