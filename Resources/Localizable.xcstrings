    "Leave all outputs unselected to let the wallet choose.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اترك جميع المخرجات غير محددة للسماح للمحفظة بالاختيار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মানিব্যাগ বেছে নিতে সব আউটপুট অনির্বাচিত ছেড়ে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lassen Sie alle Ausgaben deaktiviert, damit die Wallet auswählen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deje todas las salidas sin seleccionar para dejar que la billetera elija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez toutes les sorties désélectionnées pour laisser le portefeuille choisir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वॉलेट को चुनने देने के लिए सभी आउटपुट को अचयनित छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan semua keluaran tidak dipilih agar dompet dapat memilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lascia tutti gli output deselezionati per consentire al portafoglio di scegliere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットに選択させるには、すべての出力を選択解除したままにしておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지갑이 선택할 수 있도록 모든 출력을 선택하지 않은 상태로 둡니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan semua output tidak dipilih untuk membiarkan dompet memilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat alle uitgangen ongeselecteerd zodat de portemonnee kan kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostaw wszystkie wyjścia niezaznaczone, aby pozwolić portfelowi wybrać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixe todas as saídas desmarcadas para permitir que a carteira escolha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте все выходы невыбранными, чтобы кошелек мог выбирать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämna alla utgångar omarkerade för att låta plånboken välja."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acha matokeo yote bila kuchaguliwa ili kuruhusu pochi kuchagua."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปล่อยเอาต์พุตทั้งหมดไว้โดยไม่เลือกเพื่อให้กระเป๋าเงินเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "M-cüzdanın seçim yapmasına izin vermek için tüm çıktıları seçilmemiş bırakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bỏ chọn tất cả các đầu ra để cho ví chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保留所有输出未选择，让钱包选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保留所有輸出未選擇，讓錢包選擇。"
          }
        }
      }
    },
    "Leave blank to scan from the beginning. An earlier height includes older payments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اتركه فارغًا للمسح الضوئي من البداية. يشمل الارتفاع السابق المدفوعات الأقدم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শুরু থেকে স্ক্যান করতে ফাঁকা ছেড়ে দিন। একটি আগের উচ্চতা পুরানো পেমেন্ট অন্তর্ভুক্ত."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lassen Sie das Feld leer, um von Anfang an zu scannen. Eine frühere Höhe umfasst auch ältere Zahlungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déjelo en blanco para escanear desde el principio. Una altura anterior incluye pagos anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laissez vide pour numériser depuis le début. Une hauteur antérieure inclut les paiements plus anciens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रारंभ से स्कैन करने के लिए खाली छोड़ें. पहले की ऊंचाई में पुराने भुगतान शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan kosong untuk memindai dari awal. Ketinggian yang lebih awal mencakup pembayaran yang lebih lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lascia vuoto per eseguire la scansione dall'inizio. Un'altezza precedente include pagamenti più vecchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最初からスキャンする場合は空白のままにします。以前の高さには、古い支払いが含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "처음부터 스캔하려면 공백으로 남겨두세요. 이전 키에는 이전 지불금이 포함됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan kosong untuk mengimbas dari awal. Ketinggian yang lebih awal termasuk pembayaran yang lebih lama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laat dit leeg om vanaf het begin te scannen. Bij een eerdere hoogte zijn ook oudere betalingen meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pozostaw puste, aby skanować od początku. Wcześniejsza wysokość uwzględnia starsze płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deixe em branco para digitalizar desde o início. Uma altura anterior inclui pagamentos mais antigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте пустым, чтобы сканировать с самого начала. Более ранняя высота включает более старые платежи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lämna tomt för att skanna från början. En tidigare höjd inkluderar äldre betalningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acha wazi ili kuchanganua tangu mwanzo. Urefu wa awali unajumuisha malipo ya zamani."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เว้นว่างไว้เพื่อสแกนตั้งแต่ต้น ความสูงก่อนหน้านี้รวมการชำระเงินที่เก่ากว่าด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baştan taramak için boş bırakın. Daha erken bir yükseklik, daha eski ödemeleri de içerir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để trống để quét lại từ đầu. Chiều cao sớm hơn bao gồm các khoản thanh toán cũ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "留空以从头开始扫描。较早的高度包括较早的付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "留空以從頭開始掃描。較早的高度包括較早的付款。"
          }
        }
      }
    },
