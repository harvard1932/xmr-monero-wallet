    "Loading prices connects directly to Kraken. Kraken sees your IP address and a request for XMR/USD prices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحميل الأسعار يتصل مباشرة بـ Kraken. يرى Kraken عنوان IP الخاص بك ويطلب أسعار XMR/USD."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ক্র্যাকেনের সাথে সরাসরি দাম লোড হচ্ছে। ক্র্যাকেন আপনার আইপি ঠিকানা এবং XMR/USD দামের জন্য একটি অনুরোধ দেখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Laden von Preisen stellt eine direkte Verbindung zu Kraken her. Kraken sieht Ihre IP-Adresse und eine Anfrage nach XMR/USD-Preisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los precios de carga se conectan directamente a Kraken. Kraken ve su dirección IP y solicita precios XMR/USD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le chargement des prix se connecte directement à Kraken. Kraken voit votre adresse IP et une demande de prix XMR/USD."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लोडिंग कीमतें सीधे क्रैकेन से जुड़ती हैं। क्रैकन आपका आईपी पता और XMR/USD कीमतों के लिए अनुरोध देखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemuatan harga terhubung langsung ke Kraken. Kraken melihat alamat IP Anda dan permintaan harga XMR/USD."
