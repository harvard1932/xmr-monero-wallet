    "Verify your recovery backup so a lost iPhone does not cost you access.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحقق من النسخة الاحتياطية للاسترداد حتى لا يكلفك جهاز iPhone المفقود الوصول إليها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার পুনরুদ্ধার ব্যাকআপ যাচাই করুন যাতে একটি হারিয়ে যাওয়া iPhone আপনার অ্যাক্সেস খরচ না করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Überprüfen Sie Ihr Wiederherstellungs-Backup, damit Ihnen ein verlorenes iPhone keinen Zugriff kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique su copia de seguridad de recuperación para que un iPhone perdido no le cueste el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifiez votre sauvegarde de récupération afin qu'un iPhone perdu ne vous coûte pas d'accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने पुनर्प्राप्ति बैकअप को सत्यापित करें ताकि खोए हुए iPhone की पहुंच में आपको कोई दिक्कत न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifikasi cadangan pemulihan Anda sehingga iPhone yang hilang tidak dikenakan biaya akses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica il tuo backup di ripristino in modo che un iPhone smarrito non ti costi l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone を紛失してもアクセスできなくなることがないよう、回復バックアップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iPhone 분실로 인해 액세스 비용이 발생하지 않도록 복구 백업을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sahkan sandaran pemulihan anda supaya iPhone yang hilang tidak memerlukan anda akses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleer uw herstelback-up, zodat een kwijtgeraakte iPhone u geen toegang kost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zweryfikuj kopię zapasową odzyskiwania, aby zagubienie iPhone'a nie wiązało się z kosztami dostępu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique seu backup de recuperação para que um iPhone perdido não custe seu acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверьте резервную копию для восстановления, чтобы потеря iPhone не стоила вам доступа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifiera din återställningssäkerhetskopia så att en borttappad iPhone inte kostar dig åtkomst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thibitisha nakala yako ya urejeshaji ili iPhone iliyopotea isikugharimu kuifikia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบการสำรองข้อมูลการกู้คืนของคุณ เพื่อให้ iPhone ที่สูญหายไม่เสียค่าใช้จ่ายในการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurtarma yedeklemenizi doğrulayın, böylece kayıp bir iPhone'a erişim maliyeti ödemezsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xác minh bản sao lưu khôi phục của bạn để iPhone bị mất không mất phí truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "验证您的恢复备份，以便丢失的 iPhone 不会导致您无法访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "驗證您的恢復備份，以便遺失的 iPhone 不會導致您無法存取。"
          }
        }
      }
    },
