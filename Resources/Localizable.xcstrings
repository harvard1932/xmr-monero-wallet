    "Daily closes from Kraken through %@. The current day updates while trading continues.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عمليات إغلاق يومية من Kraken عبر %@. يتم تحديث اليوم الحالي أثناء استمرار التداول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ক্রাকেন থেকে %@ এর মাধ্যমে দৈনিক বন্ধ হয়। ট্রেডিং চলতে থাকাকালীন বর্তমান দিনের আপডেট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Täglich geschlossen von Kraken bis %@. Der aktuelle Tag wird aktualisiert, während der Handel fortgesetzt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cierres diarios desde Kraken hasta %@. El día actual se actualiza mientras continúa la negociación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fermeture quotidienne de Kraken à %@. La journée en cours est mise à jour pendant que les échanges se poursuivent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "क्रैकन से %@ तक दैनिक बंद। ट्रेडिंग जारी रहने के दौरान वर्तमान दिन का अपडेट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutup setiap hari dari Kraken hingga %@. Pembaruan hari ini sementara perdagangan berlanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiusure giornaliere da Kraken attraverso %@. Il giorno corrente si aggiorna mentre il trading continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kraken から %@ まで毎日休業となります。取引が継続されている間、現在の日が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kraken에서 %@까지 매일 마감됩니다. 거래가 계속되는 동안 현재 날짜가 업데이트됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harian ditutup dari Kraken melalui %@. Kemas kini hari semasa semasa perdagangan diteruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dagelijks gesloten van Kraken tot en met %@. De huidige dag wordt bijgewerkt terwijl de handel doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Codziennie zamyka się od Krakena do %@. Bieżący dzień jest aktualizowany podczas kontynuowania handlu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fecha diariamente de Kraken através de %@. O dia atual é atualizado enquanto a negociação continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ежедневное закрытие от Kraken до %@. Текущий день обновляется, пока торговля продолжается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stängs dagligen från Kraken till %@. Den aktuella dagen uppdateras medan handeln fortsätter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hufungwa kila siku kutoka Kraken kupitia %@. Masasisho ya siku ya sasa wakati biashara inaendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดทุกวันจาก Kraken ถึง %@ การอัปเดตวันปัจจุบันในขณะที่การซื้อขายดำเนินต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kraken'den %@'ye kadar günlük kapanışlar. Ticaret devam ederken güncel gün güncellenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đóng hàng ngày từ Kraken đến %@. Cập nhật ngày hiện tại trong khi giao dịch vẫn tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kraken 每日通过 %@ 关闭。当交易继续时，当天会更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kraken 每日透過 %@ 關閉。當交易繼續時，當天會更新。"
          }
        }
      }
    },
