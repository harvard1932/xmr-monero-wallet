    "Broadcast this signed transaction on %@ using the online wallet. Confirm you reviewed it on the signer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم ببث هذه المعاملة الموقعة على %@ باستخدام المحفظة عبر الإنترنت. أكد أنك قمت بمراجعته على الموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অনলাইন ওয়ালেট ব্যবহার করে %@-এ এই স্বাক্ষরিত লেনদেন সম্প্রচার করুন। আপনি স্বাক্ষরকারীতে এটি পর্যালোচনা করেছেন তা নিশ্চিত করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Übertragen Sie diese signierte Transaktion über das Online-Wallet auf %@. Bestätigen Sie, dass Sie es beim Unterzeichner überprüft haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transmita esta transacción firmada en %@ usando la billetera en línea. Confirme que lo revisó en el firmante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diffusez cette transaction signée sur %@ en utilisant le portefeuille en ligne. Confirmez que vous l'avez examiné sur le signataire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस हस्ताक्षरित लेनदेन को ऑनलाइन वॉलेट का उपयोग करके %@ पर प्रसारित करें। पुष्टि करें कि आपने हस्ताक्षरकर्ता पर इसकी समीक्षा की है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siarkan transaksi yang ditandatangani ini di %@ menggunakan dompet online. Konfirmasikan bahwa Anda telah meninjaunya pada penandatangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trasmetti questa transazione firmata su %@ utilizzando il portafoglio online. Conferma di averlo rivisto sul firmatario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オンラインウォレットを使用して、この署名済みトランザクションを%@でブロードキャストします。署名者がレビューしたことを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "온라인 지갑을 사용하여 %@에서 서명된 이 거래를 방송하세요. 서명자에게 검토했음을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siarkan transaksi yang ditandatangani ini di %@ menggunakan dompet dalam talian. Confirm you reviewed it on the signer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zend deze ondertekende transactie uit op %@ met behulp van de online portemonnee. Bevestig dat je het hebt gecontroleerd op de ondertekenaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Roześlij tę podpisaną transakcję na %@ za pomocą portfela online. Potwierdź, że sprawdziłeś to u osoby podpisującej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transmita esta transação assinada no %@ usando a carteira online. Confirme que você o revisou no signatário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Транслируйте эту подписанную транзакцию на %@ с помощью онлайн-кошелька. Подтвердите, что вы проверили его у подписывающего лица."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sänd den här signerade transaktionen på %@ med hjälp av onlineplånboken. Bekräfta att du har granskat den på undertecknaren."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tangaza muamala huu uliotiwa saini kwenye %@ ukitumia pochi ya mtandaoni. Thibitisha kuwa uliikagua kwenye mtiaji sahihi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ออกอากาศธุรกรรมที่ลงนามนี้บน %@ โดยใช้กระเป๋าเงินออนไลน์ ยืนยันว่าคุณได้ตรวจสอบแล้วกับผู้ลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu imzalı işlemi çevrimiçi cüzdanı kullanarak %@'de yayınlayın. İmzalayanda incelediğinizi onaylayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phát sóng giao dịch đã ký này trên %@ bằng ví trực tuyến. Xác nhận bạn đã xem xét nó trên người ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用在线钱包在 %@ 上广播此签名交易。确认您已对签名者进行了审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用線上錢包在 %@ 上廣播此簽名交易。確認您已對簽署者進行了審核。"
          }
        }
      }
