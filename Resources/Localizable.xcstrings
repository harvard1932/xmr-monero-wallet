    "Ring signatures hide the real input among decoys. A one-time address receives each output.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تخفي التوقيعات الحلقية المُدخل الحقيقي بين مُدخلات تمويهية. يتلقى عنوان يُستخدم مرة واحدة كل مُخرج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রিং স্বাক্ষর ছদ্ম ইনপুটগুলির মধ্যে আসল ইনপুটটি আড়াল করে। প্রতিটি আউটপুট একটি একবার ব্যবহারযোগ্য ঠিকানায় যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ringsignaturen verbergen den echten Input unter mehreren Ködern. Jeder Output geht an eine Einmaladresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las firmas de anillo ocultan la entrada real entre señuelos. Cada salida se recibe en una dirección de un solo uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les signatures en anneau dissimulent l’entrée réelle parmi des leurres. Chaque sortie est reçue à une adresse à usage unique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिंग हस्ताक्षर असली इनपुट को भ्रामक इनपुटों के बीच छिपाते हैं। हर आउटपुट एक बार इस्तेमाल होने वाले पते पर जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanda tangan cincin menyembunyikan input asli di antara umpan. Setiap output diterima oleh alamat sekali pakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le firme ad anello nascondono l’input reale tra le esche. Ogni output arriva a un indirizzo monouso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リング署名は実際の入力をおとりに紛れさせます。各出力の受取先には一度限りのアドレスが使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "링 서명은 실제 입력을 미끼 입력 사이에 숨깁니다. 각 출력은 일회용 주소로 전달됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tandatangan cincin menyembunyikan input sebenar antara input umpan. Setiap output diterima oleh alamat sekali guna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ringhandtekeningen verbergen de echte invoer tussen afleiders. Elke uitvoer wordt op een eenmalig adres ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podpisy pierścieniowe ukrywają rzeczywiste wejście wśród wejść pozornych. Każde wyjście trafia na jednorazowy adres."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas em anel ocultam a entrada real entre chamarizes. Cada saída vai para um endereço de uso único."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кольцевые подписи скрывают настоящий вход среди ложных. Каждый выход поступает на одноразовый адрес."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ringsignaturer döljer den verkliga ingången bland skeningångar. Varje utgång tas emot på en engångsadress."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sahihi za pete huficha ingizo halisi kati ya maingizo ya kupotosha. Kila towe hupokelewa kwa anwani ya matumizi moja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลายเซ็นแบบวงแหวนซ่อนอินพุตจริงไว้ท่ามกลางอินพุตลวง แต่ละเอาต์พุตส่งไปยังที่อยู่แบบใช้ครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Halka imzaları gerçek girdiyi yanıltıcı girdiler arasında gizler. Her çıktı tek kullanımlık bir adrese gider."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chữ ký vòng giấu đầu vào thật giữa các đầu vào mồi. Mỗi đầu ra được gửi đến một địa chỉ dùng một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "环签名将真实输入隐藏在诱饵输入中。每个输出都发送至一次性地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "環簽章將真正的輸入隱藏在誘餌輸入之中。每個輸出都會送至一次性位址。"
          }
        }
      }
    },
