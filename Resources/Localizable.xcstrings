    "Tor could not build a circuit. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتمكن تور من بناء دائرة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "টর একটি সার্কিট তৈরি করতে পারেনি। আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor konnte keinen Schaltkreis aufbauen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor no pudo construir un circuito. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor n'a pas pu construire un circuit. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टोर सर्किट नहीं बना सका. अपना कनेक्शन जांचें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor tidak dapat membangun sirkuit. Periksa koneksi Anda dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor non è riuscito a costruire un circuito. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor は回路を構築できませんでした。接続を確認して、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor는 회로를 만들 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor tidak dapat membina litar. Semak sambungan anda dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor kon geen circuit bouwen. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor nie mógł zbudować obwodu. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor não conseguiu construir um circuito. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тор не смог построить схему. Проверьте подключение и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor kunde inte bygga en krets. Kontrollera din anslutning och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor haikuweza kuunda mzunguko. Angalia muunganisho wako na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทอร์ไม่สามารถสร้างวงจรได้ ตรวจสอบการเชื่อมต่อของคุณแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor bir devre kuramadı. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor không thể xây dựng được mạch điện. Hãy kiểm tra kết nối của bạn và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor 无法构建电路。检查您的连接并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor 無法建構電路。檢查您的連線並重試。"
          }
        }
      }
    },
