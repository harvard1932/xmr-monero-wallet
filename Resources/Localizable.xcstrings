    "This iPhone no longer holds the wallet unlock key. Restore from your recovery backup.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يعد جهاز iPhone هذا يحمل مفتاح فتح المحفظة. استعادة من نسخة الاسترداد الاحتياطية الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই আইফোনটি আর ওয়ালেট আনলক কী ধরে রাখে না। আপনার পুনরুদ্ধার ব্যাকআপ থেকে পুনরুদ্ধার করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses iPhone verfügt nicht mehr über den Schlüssel zum Entsperren der Brieftasche. Stellen Sie Ihr Wiederherstellungs-Backup wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este iPhone ya no tiene la clave de desbloqueo de la billetera. Restaura desde tu copia de seguridad de recuperación."
          }
        },
        "fr": {
