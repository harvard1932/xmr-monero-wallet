        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी सार्वजनिक नोड ने प्रतिक्रिया नहीं दी. अपना कनेक्शन जांचें या सेटिंग्स में अपना स्वयं का नोड चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
