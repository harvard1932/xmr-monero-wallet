    "Use a Monero daemon you trust. Applying a change closes the current connection and requires unlocking again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم برنامج Monero الذي تثق به. يؤدي تطبيق التغيير إلى إغلاق الاتصال الحالي ويتطلب إلغاء القفل مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি বিশ্বাস করেন একটি Monero ডেমন ব্যবহার করুন. একটি পরিবর্তন প্রয়োগ করা বর্তমান সংযোগ বন্ধ করে দেয় এবং আবার আনলক করার প্রয়োজন হয়৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie einen Monero-Daemon, dem Sie vertrauen. Das Anwenden einer Änderung schließt die aktuelle Verbindung und erfordert eine erneute Entsperrung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilice un demonio Monero en el que confíe. Al aplicar un cambio se cierra la conexión actual y es necesario desbloquearla nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez un démon Monero en qui vous avez confiance. L'application d'une modification ferme la connexion actuelle et nécessite un nouveau déverrouillage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिस मोनेरो डेमॉन पर आप भरोसा करते हैं उसका उपयोग करें। परिवर्तन लागू करने से वर्तमान कनेक्शन बंद हो जाता है और फिर से अनलॉक करने की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gunakan daemon Monero yang Anda percayai. Menerapkan perubahan akan menutup koneksi saat ini dan memerlukan pembukaan kunci lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa un demone Monero di cui ti fidi. L'applicazione di una modifica chiude la connessione corrente e richiede nuovamente lo sblocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "信頼できる Monero デーモンを使用してください。変更を適用すると現在の接続が閉じられるため、再度ロックを解除する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "신뢰할 수 있는 Monero 데몬을 사용하세요. 변경 사항을 적용하면 현재 연결이 닫히고 다시 잠금을 해제해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gunakan daemon Monero yang anda percayai. Menerapkan perubahan akan menutup sambungan semasa dan memerlukan buka kunci semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik een Monero-daemon die u vertrouwt. Als u een wijziging doorvoert, wordt de huidige verbinding gesloten en moet deze opnieuw worden ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Użyj demona Monero, któremu ufasz. Zastosowanie zmiany powoduje zamknięcie bieżącego połączenia i wymaga ponownego odblokowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use um daemon Monero em que você confia. Aplicar uma alteração fecha a conexão atual e requer desbloqueio novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте демон Monero, которому вы доверяете. Применение изменения закрывает текущее соединение и требует повторной разблокировки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd en Monero-demon du litar på. Genom att tillämpa en ändring stänger den aktuella anslutningen och kräver upplåsning igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tumia daemoni ya Monero unayoamini. Utekelezaji wa mabadiliko hufunga muunganisho wa sasa na unahitaji kufungua tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใช้ Monero daemon ที่คุณไว้วางใจ การใช้การเปลี่ยนแปลงจะปิดการเชื่อมต่อปัจจุบันและจำเป็นต้องปลดล็อคอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Güvendiğiniz bir Monero arka plan programı kullanın. Bir değişikliğin uygulanması mevcut bağlantıyı kapatır ve kilidin yeniden açılmasını gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sử dụng daemon Monero mà bạn tin tưởng. Việc áp dụng thay đổi sẽ đóng kết nối hiện tại và yêu cầu mở khóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用您信任的门罗币守护程序。应用更改会关闭当前连接并需要再次解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用您信任的門羅幣守護程式。應用程式變更會關閉目前連線並需要再次解鎖。"
          }
        }
      }
    },
