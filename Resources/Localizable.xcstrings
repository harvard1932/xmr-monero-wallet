    "Keep these words in order on paper. Anyone with this phrase can spend your Monero.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب هذه الكلمات بالترتيب على ورقة. يمكن لأي شخص يعرف العبارة إنفاق رصيد مونيرو الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দগুলো ক্রমানুসারে কাগজে লিখে রাখুন। এই শব্দগুলো জানলে যে কেউ আপনার Monero খরচ করতে পারবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe diese Wörter in der richtigen Reihenfolge auf Papier. Wer die Wörter kennt, kann deine Monero ausgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota estas palabras en orden en un papel. Cualquier persona que conozca la frase puede gastar tus moneros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez ces mots dans l’ordre sur du papier. Toute personne qui connaît cette phrase peut dépenser vos moneros."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन शब्दों को इसी क्रम में कागज़ पर लिखें। जिसे भी यह वाक्यांश पता है, वह आपके Monero खर्च कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis kata-kata ini secara berurutan di atas kertas. Siapa pun yang mengetahui frasa ini dapat membelanjakan Monero Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi queste parole su carta nell’ordine indicato. Chiunque conosca la frase può spendere i tuoi monero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を表示された順番で紙に書き留めてください。このフレーズを知っていれば、誰でもあなたのMoneroを送金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들을 순서대로 종이에 적으세요. 이 문구를 아는 사람은 누구나 내 모네로를 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis perkataan ini mengikut urutan di atas kertas. Sesiapa yang mengetahui frasa ini boleh membelanjakan Monero anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf deze woorden in de juiste volgorde op papier. Iedereen die de herstelzin kent, kan je monero uitgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz te słowa na papierze w podanej kolejności. Każdy, kto zna tę frazę, może wydać Twoje monero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote estas palavras em ordem em um papel. Qualquer pessoa que conheça a frase pode gastar seus moneros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите эти слова на бумаге по порядку. Любой, кто знает эту фразу, может потратить ваши монеты Monero."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika maneno haya kwenye karatasi kwa mpangilio wake. Mtu yeyote anayejua maneno haya anaweza kutumia Monero zako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดคำเหล่านี้ลงบนกระดาษตามลำดับ ผู้ใดที่รู้วลีนี้จะสามารถใช้จ่าย Monero ของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeleri sırasıyla kâğıda yazın. Bu ifadeyi bilen herkes Monero’nuzu harcayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi những từ này ra giấy theo đúng thứ tự. Bất kỳ ai biết cụm từ này đều có thể chi tiêu Monero của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这些词按顺序写在纸上。任何知道这组助记词的人都能花费你的门罗币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將這些詞依序寫在紙上。任何知道這組助記詞的人都能花用你的門羅幣。"
          }
        }
      }
    },
