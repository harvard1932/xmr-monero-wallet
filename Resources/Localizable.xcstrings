        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein öffentlicher Knoten hat geantwortet. Überprüfen Sie Ihre Verbindung oder wählen Sie in den Einstellungen Ihren eigenen Knoten aus."
          }
        },
        "es": {
          "stringUnit": {
