        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ওয়ালেট ফাইল সংরক্ষণ করা যায়নি. চালিয়ে যাওয়ার আগে আপনার ওয়ালেট আনলক করুন এবং চেক করুন।"
