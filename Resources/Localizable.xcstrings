    "This removes every wallet, recovery backup, contact, invoice, Tor cache and setting from this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يؤدي هذا إلى إزالة كل المحفظة والنسخ الاحتياطي للاسترداد وجهات الاتصال والفاتورة وذاكرة التخزين المؤقت لـ Tor والإعدادات من جهاز iPhone هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি এই আইফোন থেকে প্রতিটি ওয়ালেট, রিকভারি ব্যাকআপ, পরিচিতি, চালান, টর ক্যাশে এবং সেটিং সরিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch werden sämtliche Wallets, Wiederherstellungs-Backups, Kontakte, Rechnungen, Tor-Cache und Einstellungen von diesem iPhone entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina cada billetera, copia de seguridad de recuperación, contacto, factura, caché Tor y configuración de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprime tous les portefeuilles, sauvegardes de récupération, contacts, factures, cache Tor et paramètres de cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह इस iPhone से हर वॉलेट, रिकवरी बैकअप, संपर्क, इनवॉइस, टोर कैश और सेटिंग को हटा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini menghapus semua dompet, cadangan pemulihan, kontak, faktur, cache Tor, dan pengaturan dari iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo rimuove ogni portafoglio, backup di ripristino, contatto, fattura, cache Tor e impostazione da questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これにより、この iPhone からすべてのウォレット、回復バックアップ、連絡先、請求書、Tor キャッシュ、および設定が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이렇게 하면 이 iPhone에서 모든 지갑, 복구 백업, 연락처, 청구서, Tor 캐시 및 설정이 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini mengalih keluar setiap dompet, sandaran pemulihan, kenalan, invois, cache Tor dan tetapan daripada iPhone ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiermee worden elke portemonnee, herstelback-up, contact, factuur, Tor-cache en instelling van deze iPhone verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spowoduje to usunięcie każdego portfela, kopii zapasowej odzyskiwania, kontaktu, faktury, pamięci podręcznej Tor i ustawień z tego iPhone'a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso remove todas as carteiras, backups de recuperação, contatos, faturas, cache Tor e configurações deste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При этом с этого iPhone будут удалены все кошельки, резервные копии для восстановления, контакты, счета, кэш Tor и настройки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detta tar bort alla plånböcker, återställningsbackup, kontakt, faktura, Tor-cache och inställning från denna iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hii huondoa kila mkoba, hifadhi rudufu, anwani, ankara, kashe ya Tor na mipangilio kutoka kwa iPhone hii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้จะลบกระเป๋าเงิน การสำรองข้อมูลการกู้คืน ผู้ติดต่อ ใบแจ้งหนี้ แคช Tor และการตั้งค่าทั้งหมดออกจาก iPhone นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu, bu iPhone'daki tüm cüzdanları, kurtarma yedeklemelerini, kişileri, faturaları, Tor önbelleğini ve ayarları kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác này sẽ xóa mọi ví, sao lưu khôi phục, liên hệ, hóa đơn, bộ đệm Tor và cài đặt khỏi iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这会从此 iPhone 中删除所有钱包、恢复备份、联系人、发票、Tor 缓存和设置。"
