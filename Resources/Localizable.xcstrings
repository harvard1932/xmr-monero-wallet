    "Check every destination, amount and fee before signing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحقق من كل وجهة ومبلغ ورسوم قبل التوقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সাইন ইন করার আগে প্রতিটি গন্তব্য, পরিমাণ এবং ফি চেক করুন।"
