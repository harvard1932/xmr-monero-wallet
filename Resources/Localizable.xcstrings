    "Frozen outputs stay unavailable for spending until you thaw them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظل المخرجات المجمدة غير متاحة للإنفاق حتى تقوم بإذابتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "হিমায়িত আউটপুটগুলি যতক্ষণ না আপনি সেগুলি গলাচ্ছেন ততক্ষণ ব্যয়ের জন্য অনুপলব্ধ থাকে৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eingefrorene Ausgaben können erst dann ausgegeben werden, wenn Sie sie auftauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los productos congelados no están disponibles para gastar hasta que los descongele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les sorties gelées ne peuvent pas être dépensées jusqu'à ce que vous les décongeliez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जमे हुए आउटपुट तब तक खर्च करने के लिए अनुपलब्ध रहते हैं जब तक आप उन्हें पिघला नहीं देते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hasil yang dibekukan tetap tidak dapat dibelanjakan sampai Anda mencairkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le uscite congelate rimangono non disponibili per la spesa finché non le scongela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "凍結された出力は、解凍するまで使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "동결된 출력은 해동할 때까지 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Output beku kekal tidak tersedia untuk dibelanjakan sehingga anda mencairkannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bevroren producten kunnen niet worden uitgegeven totdat u ze ontdooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zamrożone produkty pozostają niedostępne do wydania, dopóki ich nie rozmrozisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os resultados congelados permanecem indisponíveis para gastos até que você os descongele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Замороженные продукты остаются недоступными для расходования, пока вы их не разморозите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Frysta utgångar förblir otillgängliga för utgifter tills du tinar upp dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matokeo yaliyogandishwa husalia bila kupatikana kwa matumizi hadi uyayeyushe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ผลผลิตที่แช่แข็งจะไม่สามารถใช้ได้จนกว่าคุณจะละลาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dondurulmuş çıktılar, siz onları çözene kadar harcama için kullanılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đầu ra bị đóng băng sẽ không có sẵn để chi tiêu cho đến khi bạn rã đông chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "冻结的输出在解冻之前将无法用于支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "凍結的輸出在解凍之前將無法用於支出。"
          }
        }
      }
    },
    "Give your wallet a name. You’ll then write down its recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمًا لمحفظتك. بعد ذلك ستدوّن عبارة الاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেটের একটি নাম দিন। এরপর এটির পুনরুদ্ধারের শব্দগুচ্ছ লিখে রাখবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deiner Wallet einen Namen. Danach schreibst du die Wiederherstellungswörter auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un nombre a la cartera. A continuación, anotarás su frase de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un nom à votre portefeuille. Vous noterez ensuite sa phrase de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
