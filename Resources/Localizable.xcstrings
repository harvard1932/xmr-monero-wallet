          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed podpisaniem sprawdź każde miejsce docelowe, kwotę i opłatę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifique cada destino, valor e taxa antes de assinar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед подписанием проверьте каждое направление, сумму и сбор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
