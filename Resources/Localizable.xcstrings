        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पुनर्स्थापित पता मूल पते से भिन्न है। अपना वाक्यांश, पासफ़्रेज़ और पुनर्प्राप्ति विधि जांचें।"
