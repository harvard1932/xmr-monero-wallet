    "This deletes local wallets, the app PIN and settings. You will need your recovery backups.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يؤدي هذا إلى حذف المحافظ المحلية ورقم التعريف الشخصي للتطبيق والإعدادات. سوف تحتاج إلى النسخ الاحتياطية للاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি স্থানীয় ওয়ালেট, অ্যাপ পিন এবং সেটিংস মুছে দেয়। আপনি আপনার পুনরুদ্ধার ব্যাকআপ প্রয়োজন হবে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dadurch werden lokale Wallets, die App-PIN und Einstellungen gelöscht. Sie benötigen Ihre Wiederherstellungs-Backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina las billeteras locales, el PIN de la aplicación y la configuración. Necesitará sus copias de seguridad de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela supprime les portefeuilles locaux, le code PIN de l'application et les paramètres. Vous aurez besoin de vos sauvegardes de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इससे स्थानीय वॉलेट, ऐप पिन और सेटिंग्स हट जाती हैं। आपको अपने पुनर्प्राप्ति बैकअप की आवश्यकता होगी."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini menghapus dompet lokal, PIN aplikasi, dan pengaturan. Anda akan memerlukan cadangan pemulihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ciò elimina i portafogli locali, il PIN dell'app e le impostazioni. Avrai bisogno dei backup di ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これにより、ローカルウォレット、アプリのPIN、設定が削除されます。回復バックアップが必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이렇게 하면 로컬 지갑, 앱 PIN 및 설정이 삭제됩니다. 복구 백업이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini memadamkan dompet tempatan, PIN dan tetapan apl. Anda memerlukan sandaran pemulihan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiermee worden lokale portemonnees, de app-pincode en instellingen verwijderd. U heeft uw herstelback-ups nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spowoduje to usunięcie portfeli lokalnych, kodu PIN aplikacji i ustawień. Będziesz potrzebować kopii zapasowych odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso exclui carteiras locais, o PIN do aplicativo e as configurações. Você precisará de seus backups de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При этом будут удалены локальные кошельки, PIN-код приложения и настройки. Вам понадобятся резервные копии для восстановления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detta tar bort lokala plånböcker, app-PIN och inställningar. Du behöver dina återställningsbackuper."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hii inafuta pochi za ndani, PIN ya programu na mipangilio. Utahitaji chelezo zako za urejeshaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การดำเนินการนี้จะลบกระเป๋าสตางค์ในเครื่อง PIN ของแอป และการตั้งค่า คุณจะต้องสำรองข้อมูลการกู้คืนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu, yerel cüzdanları, uygulama PIN'ini ve ayarları siler. Kurtarma yedeklerinize ihtiyacınız olacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thao tác này sẽ xóa ví cục bộ, mã PIN ứng dụng và cài đặt. Bạn sẽ cần bản sao lưu phục hồi của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这将删除本地钱包、应用程序 PIN 码和设置。您将需要恢复备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這將刪除本機錢包、應用程式 PIN 碼和設定。您将需要恢复备份。"
          }
        }
      }
    },
