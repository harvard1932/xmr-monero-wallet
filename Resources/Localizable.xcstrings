    "Create addresses and review saved activity offline. A node is required to scan or send.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إنشاء عناوين ومراجعة النشاط المحفوظ في وضع عدم الاتصال. العقدة مطلوبة للمسح أو الإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ঠিকানা তৈরি করুন এবং অফলাইনে সংরক্ষিত কার্যকলাপ পর্যালোচনা করুন। স্ক্যান বা পাঠাতে একটি নোড প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erstellen Sie Adressen und überprüfen Sie gespeicherte Aktivitäten offline. Zum Scannen oder Senden ist ein Knoten erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cree direcciones y revise la actividad guardada sin conexión. Se requiere un nodo para escanear o enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Créez des adresses et consultez les activités enregistrées hors ligne. Un nœud est requis pour numériser ou envoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पते बनाएं और सहेजी गई गतिविधि की ऑफ़लाइन समीक्षा करें। स्कैन करने या भेजने के लिए एक नोड की आवश्यकता होती है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buat alamat dan tinjau aktivitas tersimpan secara offline. Sebuah node diperlukan untuk memindai atau mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crea indirizzi e rivedi le attività salvate offline. È necessario un nodo per eseguire la scansione o l'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アドレスを作成し、保存されたアクティビティをオフラインで確認します。スキャンまたは送信にはノードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "주소를 만들고 저장된 활동을 오프라인으로 검토하세요. 스캔하거나 전송하려면 노드가 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buat alamat dan semak aktiviti yang disimpan di luar talian. Nod diperlukan untuk mengimbas atau menghantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak adressen en bekijk opgeslagen activiteiten offline. Er is een knooppunt vereist om te scannen of te verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twórz adresy i przeglądaj zapisaną aktywność offline. Do skanowania lub wysyłania wymagany jest węzeł."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crie endereços e revise atividades salvas off-line. É necessário um nó para digitalizar ou enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Создавайте адреса и просматривайте сохраненные действия в автономном режиме. Для сканирования или отправки требуется узел."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skapa adresser och granska sparad aktivitet offline. En nod krävs för att skanna eller skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unda anwani na ukague shughuli iliyohifadhiwa nje ya mtandao. Nodi inahitajika ili kuchanganua au kutuma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สร้างที่อยู่และตรวจสอบกิจกรรมที่บันทึกไว้แบบออฟไลน์ จำเป็นต้องมีโหนดในการสแกนหรือส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adresler oluşturun ve kaydedilen etkinlikleri çevrimdışı olarak inceleyin. Taramak veya göndermek için bir düğüm gereklidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tạo địa chỉ và xem lại hoạt động đã lưu ngoại tuyến. Cần có một nút để quét hoặc gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "创建地址并离线查看保存的活动。需要一个节点来扫描或发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
