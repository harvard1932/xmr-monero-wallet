    "Anyone with this phrase can spend your XMR. Keep your written copy private.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لأي شخص لديه هذه العبارة أن ينفق XMR الخاص بك. احتفظ بنسختك المكتوبة خاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই শব্দগুচ্ছ সহ যে কেউ আপনার XMR ব্যয় করতে পারে। আপনার লিখিত অনুলিপি ব্যক্তিগত রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeder mit diesem Satz kann Ihr XMR ausgeben. Halten Sie Ihre schriftliche Kopie vertraulich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cualquier persona con esta frase puede gastar su XMR. Mantenga su copia escrita en privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toute personne possédant cette phrase peut dépenser votre XMR. Gardez votre copie écrite privée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस वाक्यांश वाला कोई भी व्यक्ति आपका XMR खर्च कर सकता है। अपनी लिखित प्रति निजी रखें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Siapa pun yang memiliki frasa ini dapat membelanjakan XMR Anda. Jaga kerahasiaan salinan tertulis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chiunque abbia questa frase può spendere i tuoi XMR. Mantieni privata la tua copia scritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このフレーズを持つ人は誰でも XMR を使うことができます。書面によるコピーは非公開にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 문구가 있는 사람은 누구나 XMR를 사용할 수 있습니다. 귀하의 서면 사본을 비공개로 유지하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiapa yang mengetahui frasa ini boleh membelanjakan XMR anda. Rahsiakan salinan bertulis anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iedereen met deze zin kan uw XMR uitgeven. Houd uw geschreven exemplaar privé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każdy, kto ma to zdanie, może wydać swoje XMR. Zachowaj prywatność swojej pisemnej kopii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qualquer pessoa com esta frase pode gastar seu XMR. Mantenha sua cópia escrita privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Любой, у кого есть эта фраза, может потратить свой XMR. Держите свою письменную копию в тайне."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla med den här frasen kan spendera din XMR. Håll din skriftliga kopia privat."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mtu yeyote aliye na kifungu hiki cha maneno anaweza kutumia XMR yako. Weka nakala yako iliyoandikwa kwa faragha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ใครก็ตามที่มีวลีนี้สามารถใช้จ่าย XMR ของคุณได้ เก็บสำเนาที่เป็นลายลักษณ์อักษรของคุณไว้เป็นส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu ifadeyi kullanan herkes XMR'nizi harcayabilir. Yazılı kopyanızı gizli tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bất cứ ai có cụm từ này đều có thể sử dụng XMR của bạn. Giữ bản sao bằng văn bản của bạn ở chế độ riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何有这句话的人都可以花掉你的 XMR。将您的书面副本保密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "任何有這句話的人都可以花掉你的 XMR。將您的書面副本保密。"
          }
        }
      }
    },
