    "Set a device passcode in iPhone Settings to protect this wallet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بتعيين رمز مرور الجهاز في إعدادات iPhone لحماية هذه المحفظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ওয়ালেটটি সুরক্ষিত করতে iPhone সেটিংসে একটি ডিভাইস পাসকোড সেট করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legen Sie in den iPhone-Einstellungen einen Gerätepasscode fest, um diese Brieftasche zu schützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Establezca un código de acceso del dispositivo en la configuración del iPhone para proteger esta billetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Définissez un mot de passe pour l'appareil dans les paramètres de l'iPhone pour protéger ce portefeuille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस वॉलेट की सुरक्षा के लिए iPhone सेटिंग्स में एक डिवाइस पासकोड सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atur kode sandi perangkat di Pengaturan iPhone untuk melindungi dompet ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imposta un passcode del dispositivo nelle Impostazioni dell'iPhone per proteggere questo portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このウォレットを保護するには、iPhone の設定でデバイスのパスコードを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 지갑을 보호하려면 iPhone 설정에서 장치 비밀번호를 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tetapkan kod laluan peranti dalam Tetapan iPhone untuk melindungi dompet ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stel een apparaattoegangscode in in de iPhone-instellingen om deze portemonnee te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustaw hasło urządzenia w Ustawieniach iPhone'a, aby chronić ten portfel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Defina uma senha do dispositivo nas configurações do iPhone para proteger esta carteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Установите пароль устройства в настройках iPhone, чтобы защитить этот кошелек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ställ in ett lösenord för enheten i iPhone-inställningarna för att skydda den här plånboken."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weka nambari ya siri ya kifaa katika Mipangilio ya iPhone ili kulinda pochi hii."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้งรหัสผ่านอุปกรณ์ในการตั้งค่า iPhone เพื่อปกป้องกระเป๋าเงินนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu cüzdanı korumak için iPhone Ayarlarında bir cihaz parolası ayarlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt mật mã thiết bị trong Cài đặt iPhone để bảo vệ ví này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iPhone 设置中设置设备密码以保护此钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iPhone 設定中設定裝置密碼以保護此錢包。"
          }
        }
      }
    },
