    "Look at your written copy and enter the two words requested below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع نسختك المكتوبة وأدخل الكلمتين المطلوبتين أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লিখিত কপি দেখে নিচে চাওয়া দুটি শব্দ লিখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau auf deine schriftliche Sicherung und gib die beiden unten angefragten Wörter ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tu copia en papel e introduce las dos palabras solicitadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre copie papier et saisissez les deux mots demandés ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लिखी हुई प्रति देखें और नीचे माँगे गए दो शब्द दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat salinan tertulis Anda, lalu masukkan dua kata yang diminta di bawah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la copia cartacea e inserisci le due parole richieste qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書きの控えを見て、以下で指定された2つの単語を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어 둔 사본을 보고 아래에서 요청하는 두 단어를 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rujuk salinan bertulis anda dan masukkan dua perkataan yang diminta di bawah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je papieren back-up en vul de twee gevraagde woorden hieronder in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź swoją papierową kopię i wpisz dwa wskazane poniżej słowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte sua cópia em papel e digite as duas palavras solicitadas abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите на свою бумажную копию и введите два слова с указанными ниже номерами."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalia nakala yako ya karatasi na uandike maneno mawili yaliyoombwa hapa chini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสำเนาที่จดไว้และป้อนคำทั้งสองตามตำแหน่งที่ระบุด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazılı kopyanıza bakarak aşağıda istenen iki kelimeyi girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem bản ghi trên giấy và nhập hai từ theo vị trí được yêu cầu bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看你的纸质备份，输入下方指定位置的两个词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請查看你的紙本備份，輸入下方指定位置的兩個詞。"
          }
        }
      }
    },
