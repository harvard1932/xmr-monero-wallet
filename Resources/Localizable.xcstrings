    "Try public onion nodes through Tor. If a node stalls, the wallet changes nodes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جرب العقد البصلية العامة من خلال Tor. إذا توقفت العقدة، تقوم المحفظة بتغيير العقد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "টর মাধ্যমে পাবলিক পেঁয়াজ নোড চেষ্টা করুন. একটি নোড স্টল হলে, ওয়ালেট নোড পরিবর্তন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Probieren Sie öffentliche Onion-Knoten über Tor aus. Wenn ein Knoten ins Stocken gerät, wechselt das Wallet den Knoten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pruebe los nodos cebolla públicos a través de Tor. Si un nodo se detiene, la billetera cambia de nodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essayez les nœuds d'oignon publics via Tor. Si un nœud bloque, le portefeuille change de nœud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "टोर के माध्यम से सार्वजनिक प्याज नोड्स आज़माएँ। यदि कोई नोड रुक जाता है, तो वॉलेट नोड बदल देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coba node bawang publik melalui Tor. Jika sebuah node terhenti, dompet akan mengubah node."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prova i nodi Onion pubblici tramite Tor. Se un nodo si blocca, il portafoglio cambia nodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor を介してパブリック オニオン ノードを試してください。ノードが停止すると、ウォレットはノードを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor를 통해 공개 양파 노드를 사용해 보세요. 노드가 정지되면 지갑은 노드를 변경합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuba nod bawang awam melalui Tor. Jika nod terhenti, dompet menukar nod."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Probeer openbare ui-knooppunten via Tor. Als een knooppunt vastloopt, verandert de portemonnee van knooppunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wypróbuj publiczne węzły cebulowe za pośrednictwem Tora. Jeśli węzeł się zawiesi, portfel zmienia węzły."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Experimente nós cebola públicos através do Tor. Se um nó parar, a carteira muda de nó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Попробуйте публичные луковые узлы через Tor. Если узел останавливается, кошелек меняет узлы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prova offentliga löknoder genom Tor. Om en nod stannar byter plånboken noder."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jaribu nodi za vitunguu za umma kupitia Tor. Ikiwa nodi itasimama, mkoba hubadilisha nodi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลองใช้โหนดหัวหอมสาธารณะผ่าน Tor หากโหนดหยุดทำงาน กระเป๋าเงินจะเปลี่ยนโหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tor aracılığıyla genel soğan düğümlerini deneyin. Bir düğüm durursa cüzdan düğümleri değiştirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy thử các nút củ hành công khai thông qua Tor. Nếu một nút bị đình trệ, ví sẽ thay đổi các nút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "通过 Tor 尝试公共洋葱节点。如果节点停止运行，钱包就会更改节点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "透過 Tor 嘗試公共洋蔥節點。如果節點停止運行，錢包就會更改節點。"
          }
        }
      }
    },
