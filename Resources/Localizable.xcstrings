        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Công cụ gốc yêu cầu vận chuyển an toàn cục bộ hoặc nút hành Tor v3 thông qua proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
