    "Import requires permission to check spent key images with your node.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب الاستيراد إذنًا للتحقق من الصور الرئيسية المستهلكة باستخدام عقدتك."
