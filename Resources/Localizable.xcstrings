    "Recovery setup is complete. Keep your written backup private.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتمل إعداد الاسترداد. احتفظ بنسختك الاحتياطية المكتوبة خاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পুনরুদ্ধার সেটআপ সম্পূর্ণ হয়েছে৷ আপনার লিখিত ব্যাকআপ ব্যক্তিগত রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Wiederherstellungseinrichtung ist abgeschlossen. Halten Sie Ihr schriftliches Backup privat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuración de recuperación está completa. Mantenga privada su copia de seguridad escrita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La configuration de la récupération est terminée. Gardez votre sauvegarde écrite privée."
