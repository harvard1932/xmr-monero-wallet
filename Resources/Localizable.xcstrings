          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN-pogingen zijn vergrendeld. Reset uw pincode met de iPhone-toegangscode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Próby wprowadzenia PIN-u są zablokowane. Zresetuj swój PIN za pomocą hasła iPhone'a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
