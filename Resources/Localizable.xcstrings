    "PIN attempts are locked. Reset your PIN with the iPhone passcode.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "محاولات رقم التعريف الشخصي مقفلة. أعد تعيين رقم التعريف الشخصي (PIN) الخاص بك باستخدام رمز مرور iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পিন প্রচেষ্টা লক করা আছে. আইফোন পাসকোড দিয়ে আপনার পিন রিসেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN-Versuche sind gesperrt. Setzen Sie Ihre PIN mit dem iPhone-Passcode zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los intentos de PIN están bloqueados. Restablezca su PIN con la contraseña del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les tentatives de code PIN sont verrouillées. Réinitialisez votre code PIN avec le mot de passe de l'iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पिन प्रयास लॉक हैं. iPhone पासकोड से अपना पिन रीसेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upaya PIN terkunci. Setel ulang PIN Anda dengan kode sandi iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tentativi PIN sono bloccati. Reimposta il tuo PIN con il passcode dell'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN の試行はロックされています。 iPhone のパスコードを使用して PIN をリセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PIN 시도가 잠겨 있습니다. iPhone 비밀번호로 PIN을 재설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
