          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "응답한 공개 노드가 없습니다. 연결을 확인하거나 설정에서 자체 노드를 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
