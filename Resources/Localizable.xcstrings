    "The native engine requires a local secure transport or a Tor v3 onion node through a proxy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتطلب المحرك الأصلي نقلًا آمنًا محليًا أو عقدة Tor v3 البصلية من خلال وكيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নেটিভ ইঞ্জিনের জন্য একটি স্থানীয় নিরাপদ পরিবহন বা প্রক্সির মাধ্যমে একটি Tor v3 অনিয়ন নোড প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die native Engine erfordert einen lokalen sicheren Transport oder einen Tor v3-Onion-Knoten über einen Proxy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El motor nativo requiere un transporte seguro local o un nodo cebolla Tor v3 a través de un proxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur natif nécessite un transport sécurisé local ou un nœud oignon Tor v3 via un proxy."
