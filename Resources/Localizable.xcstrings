          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controlla ogni destinazione, importo e tariffa prima di firmare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "署名する前に、宛先、金額、手数料をすべて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서명하기 전에 모든 목적지, 금액 및 수수료를 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
