    "Importing key images lets the connected node link spent outputs in this wallet. Use a node you control.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح استيراد الصور الرئيسية لرابط العقدة المتصلة إنفاق المخرجات في هذه المحفظة. استخدم العقدة التي تتحكم فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কী ইমেজ ইম্পোর্ট করলে কানেক্টেড নোড লিঙ্ক এই ওয়ালেটে আউটপুট কাটাতে দেয়। আপনি নিয়ন্ত্রণ একটি নোড ব্যবহার করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Durch den Import von Schlüsselbildern kann der verbundene Knoten ausgegebene Ausgaben in dieser Wallet verknüpfen. Verwenden Sie einen Knoten, den Sie kontrollieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La importación de imágenes clave permite que el nodo conectado vincule las salidas gastadas en esta billetera. Utilice un nodo que usted controle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'importation d'images clés permet au nœud connecté de lier les sorties dépensées dans ce portefeuille. Utilisez un nœud que vous contrôlez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मुख्य छवियों को आयात करने से कनेक्टेड नोड इस वॉलेट में खर्च किए गए आउटपुट को लिंक कर सकता है। उस नोड का उपयोग करें जिसे आप नियंत्रित करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mengimpor gambar kunci memungkinkan tautan simpul yang terhubung menghabiskan keluaran di dompet ini. Gunakan node yang Anda kendalikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'importazione delle immagini chiave consente al nodo connesso di collegare gli output spesi in questo portafoglio. Usa un nodo che controlli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーイメージをインポートすると、接続されたノードがこのウォレットで使用された出力をリンクできるようになります。自分が制御するノードを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "주요 이미지를 가져오면 연결된 노드 링크가 이 지갑에서 출력을 소비할 수 있습니다. 귀하가 제어하는 ​​노드를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
