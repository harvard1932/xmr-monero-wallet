    "This iPhone no longer holds the wallet unlock key. Verify your recovery backups, erase the local wallets, then restore them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يعد جهاز iPhone هذا يحمل مفتاح فتح المحفظة. تحقق من النسخ الاحتياطية للاسترداد، وقم بمسح المحافظ المحلية، ثم استعادتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই আইফোনটি আর ওয়ালেট আনলক কী ধরে রাখে না। আপনার পুনরুদ্ধার ব্যাকআপগুলি যাচাই করুন, স্থানীয় ওয়ালেটগুলি মুছুন, তারপর সেগুলি পুনরুদ্ধার করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
