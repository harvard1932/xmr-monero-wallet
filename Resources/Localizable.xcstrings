        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ওয়ালেট সেশনের জন্য USD মান সক্ষম করুন৷ CoinGecko মূল্য অনুরোধ গ্রহণ করে এবং আপনার আইপি ঠিকানা দেখতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivieren Sie USD-Werte für diese Wallet-Sitzung. CoinGecko erhält Preisanfragen und kann Ihre IP-Adresse sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Habilite los valores en USD para esta sesión de billetera. CoinGecko recibe solicitudes de precios y puede ver su dirección IP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez les valeurs USD pour cette session de portefeuille. CoinGecko reçoit des demandes de prix et peut voir votre adresse IP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस वॉलेट सत्र के लिए USD मान सक्षम करें। कॉइनगेको मूल्य अनुरोध प्राप्त करता है और आपका आईपी पता देख सकता है।"
