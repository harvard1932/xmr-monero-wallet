            "value": "ওয়ালেট অফলাইনে বা প্রক্সি ব্যবহার করার সময় সরাসরি মূল্যের সন্ধান অক্ষম করা হয়৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Direkte Preissuchen sind deaktiviert, während das Wallet offline ist oder einen Proxy verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las búsquedas directas de precios están deshabilitadas mientras la billetera está fuera de línea o usando un proxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les recherches directes de prix sont désactivées lorsque le portefeuille est hors ligne ou utilise un proxy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जब वॉलेट ऑफ़लाइन हो या प्रॉक्सी का उपयोग कर रहा हो तो प्रत्यक्ष मूल्य लुकअप अक्षम कर दिया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pencarian harga langsung dinonaktifkan saat dompet sedang offline atau menggunakan proxy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le ricerche dirette dei prezzi sono disabilitate mentre il portafoglio è offline o utilizza un proxy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットがオフラインであるかプロキシを使用している場合、価格の直接検索は無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지갑이 오프라인이거나 프록시를 사용하는 동안에는 직접 가격 조회가 비활성화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Carian harga langsung dilumpuhkan semasa dompet berada di luar talian atau menggunakan proksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Directe prijszoekopdrachten zijn uitgeschakeld als de portemonnee offline is of een proxy gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bezpośrednie wyszukiwanie cen jest wyłączone, gdy portfel jest w trybie offline lub korzysta z serwera proxy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As pesquisas diretas de preços são desativadas enquanto a carteira está offline ou usando um proxy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прямой поиск цен отключен, когда кошелек находится в автономном режиме или использует прокси-сервер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Direkta prissökningar är inaktiverade när plånboken är offline eller använder en proxy."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utafutaji wa bei ya moja kwa moja huzimwa wakati pochi iko nje ya mtandao au kutumia seva mbadala."
