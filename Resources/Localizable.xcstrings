    "A direct connection reveals your IP address to the node. Use Tor to conceal it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يكشف الاتصال المباشر عن عنوان IP الخاص بك للعقدة. استخدم Tor لإخفائه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি সরাসরি সংযোগ নোডে আপনার আইপি ঠিকানা প্রকাশ করে। এটি গোপন করতে টর ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei einer direkten Verbindung wird Ihre IP-Adresse dem Knoten angezeigt. Verwenden Sie Tor, um es zu verbergen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una conexión directa revela su dirección IP al nodo. Usa Tor para ocultarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une connexion directe révèle votre adresse IP au nœud. Utilisez Tor pour le cacher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक सीधा कनेक्शन आपके आईपी पते को नोड पर प्रकट करता है। इसे छुपाने के लिए टोर का प्रयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koneksi langsung mengungkapkan alamat IP Anda ke node. Gunakan Tor untuk menyembunyikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una connessione diretta rivela il tuo indirizzo IP al nodo. Usa Tor per nasconderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直接接続すると、IP アドレスがノードに公開されます。 Torを使用して隠蔽します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "직접 연결하면 IP 주소가 노드에 공개됩니다. 이를 숨기려면 Tor를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambungan terus mendedahkan alamat IP anda ke nod. Gunakan Tor untuk menyembunyikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een directe verbinding onthult uw IP-adres aan het knooppunt. Gebruik Tor om het te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bezpośrednie połączenie ujawnia węzłowi Twój adres IP. Użyj Tora, aby to ukryć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma conexão direta revela seu endereço IP ao nó. Use o Tor para ocultá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прямое соединение раскрывает ваш IP-адрес узлу. Используйте Tor, чтобы скрыть это."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En direkt anslutning avslöjar din IP-adress till noden. Använd Tor för att dölja det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muunganisho wa moja kwa moja unaonyesha anwani yako ya IP kwenye nodi. Tumia Tor kuificha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเชื่อมต่อโดยตรงเปิดเผยที่อยู่ IP ของคุณไปยังโหนด ใช้ Tor เพื่อปกปิดมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doğrudan bağlantı, IP adresinizi düğüme gösterir. Gizlemek için Tor'u kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kết nối trực tiếp sẽ tiết lộ địa chỉ IP của bạn cho nút. Sử dụng Tor để che giấu nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "直接连接会将您的 IP 地址暴露给节点。使用 Tor 来隐藏它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線會向節點透露您的 IP 位址。您可以使用 Tor 隱藏 IP 位址。"
          }
        }
      }
    },
    "A selected output is no longer spendable.": {
