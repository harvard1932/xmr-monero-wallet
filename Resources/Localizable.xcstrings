    "Start a Tor SOCKS proxy on this iPhone. Tor mode connects only to v3 onion nodes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بتشغيل وكيل Tor SOCKS على هذا iPhone. يتصل وضع Tor فقط بالعقد البصلية v3."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই আইফোনে একটি Tor SOCKS প্রক্সি শুরু করুন। টর মোড শুধুমাত্র v3 পেঁয়াজ নোডের সাথে সংযোগ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starten Sie einen Tor SOCKS-Proxy auf diesem iPhone. Der Tor-Modus stellt nur eine Verbindung zu v3-Onion-Knoten her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie un proxy Tor SOCKS en este iPhone. El modo Tor se conecta solo a nodos cebolla v3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Démarrez un proxy Tor SOCKS sur cet iPhone. Le mode Tor se connecte uniquement aux nœuds oignon v3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस iPhone पर Tor SOCKS प्रॉक्सी प्रारंभ करें। टोर मोड केवल v3 प्याज नोड्स से कनेक्ट होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulai proksi Tor SOCKS di iPhone ini. Mode Tor hanya terhubung ke node bawang v3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avvia un proxy Tor SOCKS su questo iPhone. La modalità Tor si connette solo ai nodi Onion v3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この iPhone で Tor SOCKS プロキシを開始します。 Tor モードは v3 オニオン ノードにのみ接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 iPhone에서 Tor SOCKS 프록시를 시작하세요. Tor 모드는 v3 양파 노드에만 연결됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulakan proksi Tor SOCKS pada iPhone ini. Mod Tor hanya menyambung kepada nod bawang v3."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start een Tor SOCKS-proxy op deze iPhone. Tor-modus maakt alleen verbinding met v3-uienknooppunten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uruchom serwer proxy Tor SOCKS na tym iPhonie. Tryb Tor łączy się tylko z węzłami cebulowymi v3."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie um proxy Tor SOCKS neste iPhone. O modo Tor se conecta apenas aos nós cebola v3."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запустите прокси-сервер Tor SOCKS на этом iPhone. Режим Tor подключается только к луковым узлам v3."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starta en Tor SOCKS-proxy på denna iPhone. Tor-läge ansluter endast till v3 löknoder."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anzisha proksi ya Tor SOCKS kwenye iPhone hii. Hali ya Tor inaunganisha tu na nodi za vitunguu v3."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มพร็อกซี Tor SOCKS บน iPhone นี้ โหมด Tor เชื่อมต่อกับโหนดหัวหอม v3 เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu iPhone'da Tor SOCKS proxy'sini başlatın. Tor modu yalnızca v3 soğan düğümlerine bağlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bắt đầu proxy Tor SOCKS trên iPhone này. Chế độ Tor chỉ kết nối với các nút củ hành v3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 iPhone 上启动 Tor SOCKS 代理。 Tor 模式仅连接到 v3 洋葱节点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在此 iPhone 上啟動 Tor SOCKS 代理程式。 Tor 模式僅連接到 v3 洋蔥節點。"
          }
        }
      }
