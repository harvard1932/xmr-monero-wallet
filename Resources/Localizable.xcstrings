          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Créez une nouvelle adresse de réception pour éviter de partager votre adresse principale avec chaque contact."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "प्रत्येक संपर्क के साथ अपना प्राथमिक पता साझा करने से बचने के लिए एक नया प्राप्तकर्ता पता बनाएं।"
