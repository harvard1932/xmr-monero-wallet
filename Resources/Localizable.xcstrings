    "Create a fresh receiving address to avoid sharing your primary address with every contact.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بإنشاء عنوان استلام جديد لتجنب مشاركة عنوانك الأساسي مع كل جهة اتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রতিটি পরিচিতির সাথে আপনার প্রাথমিক ঠিকানা ভাগ করা এড়াতে একটি নতুন প্রাপ্তির ঠিকানা তৈরি করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
