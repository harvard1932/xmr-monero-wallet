          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun nodo pubblico ha risposto. Controlla la tua connessione o scegli il tuo nodo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
