        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan nilai USD untuk sesi dompet ini. CoinGecko menerima permintaan harga dan dapat melihat alamat IP Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abilita i valori USD per questa sessione del portafoglio. CoinGecko riceve richieste di prezzo e può vedere il tuo indirizzo IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このウォレット セッションの USD 値を有効にします。 CoinGecko は価格リクエストを受信し、IP アドレスを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 지갑 세션에 대해 USD 값을 활성화합니다. CoinGecko는 가격 요청을 받고 귀하의 IP 주소를 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dayakan nilai USD untuk sesi dompet ini. CoinGecko menerima permintaan harga dan boleh melihat alamat IP anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel USD-waarden in voor deze portemonneesessie. CoinGecko ontvangt prijsaanvragen en kan uw IP-adres zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz wartości w USD dla tej sesji portfela. CoinGecko otrzymuje zapytania cenowe i może zobaczyć Twój adres IP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Habilite valores em USD para esta sessão de carteira. CoinGecko recebe solicitações de preços e pode ver seu endereço IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите значения в долларах США для этого сеанса кошелька. CoinGecko получает запросы цен и может видеть ваш IP-адрес."
          }
