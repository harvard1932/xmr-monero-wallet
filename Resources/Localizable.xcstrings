          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しい受信アドレスを作成して、主要なアドレスをすべての連絡先と共有しないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
