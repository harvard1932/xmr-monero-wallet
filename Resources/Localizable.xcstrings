    "Scan this code from the view-only restore screen on your online device. Anyone with this code can see incoming payments.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "امسح هذا الرمز ضوئيًا من شاشة استعادة العرض فقط على جهازك المتصل بالإنترنت. يمكن لأي شخص لديه هذا الرمز رؤية المدفوعات الواردة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার অনলাইন ডিভাইসে শুধুমাত্র দেখার-পুনরুদ্ধার স্ক্রীন থেকে এই কোডটি স্ক্যান করুন। এই কোড সহ যে কেউ ইনকামিং পেমেন্ট দেখতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannen Sie diesen Code über den schreibgeschützten Wiederherstellungsbildschirm auf Ihrem Online-Gerät. Jeder mit diesem Code kann eingehende Zahlungen sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanee este código desde la pantalla de restauración de solo lectura en su dispositivo en línea. Cualquier persona con este código puede ver los pagos entrantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scannez ce code à partir de l'écran de restauration en lecture seule sur votre appareil en ligne. Toute personne possédant ce code peut voir les paiements entrants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस कोड को अपने ऑनलाइन डिवाइस पर केवल-दृश्य पुनर्स्थापना स्क्रीन से स्कैन करें। इस कोड वाला कोई भी व्यक्ति आने वाले भुगतान देख सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pindai kode ini dari layar pemulihan hanya lihat di perangkat online Anda. Siapa pun yang memiliki kode ini dapat melihat pembayaran masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esegui la scansione di questo codice dalla schermata di ripristino di sola visualizzazione sul tuo dispositivo online. Chiunque abbia questo codice può vedere i pagamenti in entrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オンライン デバイスの表示専用復元画面からこのコードをスキャンします。このコードを持っている人は誰でも、入金を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "온라인 장치의 보기 전용 복원 화면에서 이 코드를 스캔하세요. 이 코드가 있는 사람은 누구나 입금 내역을 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imbas kod ini dari skrin pemulihan lihat sahaja pada peranti dalam talian anda. Sesiapa sahaja yang mempunyai kod ini boleh melihat pembayaran masuk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan deze code vanuit het alleen-lezen-herstelscherm op uw online apparaat. Iedereen met deze code kan binnenkomende betalingen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeskanuj ten kod na ekranie przywracania w trybie tylko do przeglądania na swoim urządzeniu internetowym. Każda osoba posiadająca ten kod może zobaczyć płatności przychodzące."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digitalize este código na tela de restauração somente visualização em seu dispositivo online. Qualquer pessoa com este código pode ver os pagamentos recebidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отсканируйте этот код на экране восстановления только для просмотра на своем онлайн-устройстве. Любой, у кого есть этот код, может видеть входящие платежи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanna den här koden från återställningsskärmen för endast visning på din onlineenhet. Alla med den här koden kan se inkommande betalningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Changanua msimbo huu kutoka kwa skrini ya kurejesha mwonekano pekee kwenye kifaa chako cha mtandaoni. Mtu yeyote aliye na nambari hii ya kuthibitisha anaweza kuona malipo yanayoingia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "สแกนโค้ดนี้จากหน้าจอการคืนค่าแบบดูอย่างเดียวบนอุปกรณ์ออนไลน์ของคุณ ทุกคนที่มีรหัสนี้จะสามารถดูการชำระเงินที่เข้ามาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kodu çevrimiçi cihazınızdaki salt görüntüleme geri yükleme ekranından tarayın. Bu koda sahip olan herkes gelen ödemeleri görebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quét mã này từ màn hình khôi phục chỉ xem trên thiết bị trực tuyến của bạn. Bất kỳ ai có mã này đều có thể thấy các khoản thanh toán đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "从在线设备上的仅供查看的恢复屏幕扫描此代码。拥有此代码的任何人都可以查看收款。"
          }
