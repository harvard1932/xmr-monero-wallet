    "The restored address differs from the original address. Check your phrase, passphrase and recovery method.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يختلف العنوان المستعاد عن العنوان الأصلي. تحقق من العبارة وكلمة المرور وطريقة الاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পুনরুদ্ধার করা ঠিকানাটি আসল ঠিকানা থেকে আলাদা। আপনার বাক্যাংশ, পাসফ্রেজ এবং পুনরুদ্ধারের পদ্ধতি পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die wiederhergestellte Adresse weicht von der ursprünglichen Adresse ab. Überprüfen Sie Ihren Satz, Ihr Passwort und Ihre Wiederherstellungsmethode."
