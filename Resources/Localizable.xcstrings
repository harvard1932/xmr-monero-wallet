    "Give your wallet a name. You’ll then write down its recovery phrase.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمًا لمحفظتك. بعد ذلك ستدوّن عبارة الاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেটের একটি নাম দিন। এরপর এটির পুনরুদ্ধারের শব্দগুচ্ছ লিখে রাখবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deiner Wallet einen Namen. Danach schreibst du die Wiederherstellungswörter auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un nombre a la cartera. A continuación, anotarás su frase de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez un nom à votre portefeuille. Vous noterez ensuite sa phrase de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वॉलेट को एक नाम दें। फिर उसका रिकवरी वाक्यांश लिखकर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri nama dompet Anda. Setelah itu, catat frasa pemulihannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome al portafoglio. Poi scriverai la sua frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットに名前を付けてください。次に復元フレーズを書き留めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 이름을 지정하세요. 다음 단계에서 복구 문구를 적습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan nama kepada dompet anda. Kemudian catat frasa pemulihannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef je wallet een naam. Daarna schrijf je de herstelzin op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj portfelowi nazwę. Następnie zapisz jego frazę odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome à carteira. Em seguida, anote a frase de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите название кошелька. Затем запишите его фразу восстановления."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipe pochi yako jina. Kisha utaandika maneno ya kuirejesha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อกระเป๋าของคุณ แล้วจดวลีกู้คืนในขั้นตอนถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdanınıza bir ad verin. Ardından kurtarma ifadesini kâğıda yazacaksınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên cho ví. Tiếp theo, bạn sẽ ghi lại cụm từ khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为钱包命名，然后写下它的助记词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為錢包命名，接著寫下它的助記詞。"
          }
        }
      }
    },
