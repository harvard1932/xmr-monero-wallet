    "You will need your recovery backup to regain access. Local labels, contacts and invoices will be lost.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستحتاج إلى نسخة احتياطية للاسترداد لاستعادة إمكانية الوصول. سيتم فقدان التسميات المحلية وجهات الاتصال والفواتير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অ্যাক্সেস পুনরুদ্ধার করতে আপনার পুনরুদ্ধার ব্যাকআপের প্রয়োজন হবে। স্থানীয় লেবেল, পরিচিতি এবং চালান হারিয়ে যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie benötigen Ihr Wiederherstellungs-Backup, um wieder Zugriff zu erhalten. Lokale Etiketten, Kontakte und Rechnungen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Necesitará su copia de seguridad de recuperación para recuperar el acceso. Se perderán las etiquetas, contactos y facturas locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous aurez besoin de votre sauvegarde de récupération pour retrouver l'accès. Les étiquettes locales, les contacts et les factures seront perdus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पहुंच पुनः प्राप्त करने के लिए आपको अपने पुनर्प्राप्ति बैकअप की आवश्यकता होगी। स्थानीय लेबल, संपर्क और चालान खो जाएंगे."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda memerlukan cadangan pemulihan untuk mendapatkan kembali akses. Label lokal, kontak, dan faktur akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avrai bisogno del backup di ripristino per riottenere l'accesso. Le etichette locali, i contatti e le fatture andranno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクセスを取り戻すには回復バックアップが必要になります。ローカルラベル、連絡先、請求書は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "액세스 권한을 다시 얻으려면 복구 백업이 필요합니다. 지역 라벨, 연락처, 송장이 손실됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda memerlukan sandaran pemulihan anda untuk mendapatkan semula akses. Label tempatan, kenalan dan invois akan hilang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "U hebt uw herstelback-up nodig om weer toegang te krijgen. Lokale labels, contacten en facturen gaan verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby odzyskać dostęp, będziesz potrzebować kopii zapasowej odzyskiwania. Lokalne etykiety, kontakty i faktury zostaną utracone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você precisará do backup de recuperação para recuperar o acesso. Etiquetas locais, contatos e faturas serão perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для восстановления доступа вам понадобится резервная копия для восстановления. Местные метки, контакты и счета-фактуры будут утеряны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du behöver din återställningsbackup för att få åtkomst igen. Lokala etiketter, kontakter och fakturor kommer att gå förlorade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utahitaji nakala yako ya urejeshaji ili kurejesha ufikiaji. Lebo za ndani, anwani na ankara zitapotea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณจะต้องมีการสำรองข้อมูลการกู้คืนเพื่อเข้าถึงได้อีกครั้ง ป้ายชื่อท้องถิ่น ผู้ติดต่อ และใบแจ้งหนี้จะหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yeniden erişim kazanmak için kurtarma yedeğinize ihtiyacınız olacak. Yerel etiketler, kişiler ve faturalar kaybolacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn sẽ cần bản sao lưu khôi phục của mình để lấy lại quyền truy cập. Nhãn địa phương, địa chỉ liên hệ và hóa đơn sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您将需要恢复备份才能重新获得访问权限。本地标签、联系方式和发票将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您將需要恢復備份才能重新獲得存取權限。本地標籤、聯絡資訊和發票將會遺失。"
          }
        }
      }
    },
    "Your score reflects five settings on this iPhone. Each contributes 20 points.": {
