    "QR scanning needs camera access on a supported iPhone. You can also paste the address.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج مسح QR إلى الوصول إلى الكاميرا على جهاز iPhone مدعوم. يمكنك أيضًا لصق العنوان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR স্ক্যানিং একটি সমর্থিত iPhone এ ক্যামেরা অ্যাক্সেস প্রয়োজন। আপনি ঠিকানা পেস্ট করতে পারেন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für das QR-Scannen ist Kamerazugriff auf einem unterstützten iPhone erforderlich. Sie können die Adresse auch einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escaneo QR necesita acceso a la cámara en un iPhone compatible. También puedes pegar la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La numérisation QR nécessite un accès à la caméra sur un iPhone pris en charge. Vous pouvez également coller l'adresse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR स्कैनिंग के लिए समर्थित iPhone पर कैमरा एक्सेस की आवश्यकता होती है। आप पता भी चिपका सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pemindaian QR memerlukan akses kamera pada iPhone yang didukung. Anda juga dapat menempelkan alamatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scansione QR richiede l'accesso alla fotocamera su un iPhone supportato. Puoi anche incollare l'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR スキャンには、サポートされている iPhone のカメラへのアクセスが必要です。アドレスを貼り付けることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR 스캔에는 지원되는 iPhone에서 카메라 액세스가 필요합니다. 주소를 붙여넣을 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pengimbasan QR memerlukan akses kamera pada iPhone yang disokong. Anda juga boleh menampal alamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voor QR-scannen is cameratoegang op een ondersteunde iPhone vereist. U kunt het adres ook plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skanowanie QR wymaga dostępu do aparatu na obsługiwanym iPhonie. Możesz także wkleić adres."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A digitalização QR precisa de acesso à câmera em um iPhone compatível. Você também pode colar o endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Для сканирования QR требуется доступ к камере на поддерживаемом iPhone. Вы также можете вставить адрес."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR-skanning kräver kameraåtkomst på en iPhone som stöds. Du kan också klistra in adressen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuchanganua QR kunahitaji ufikiaji wa kamera kwenye iPhone inayotumika. Unaweza pia kubandika anwani."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การสแกน QR จำเป็นต้องเข้าถึงกล้องบน iPhone ที่รองรับ คุณยังสามารถวางที่อยู่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR tarama, desteklenen bir iPhone'da kamera erişimine ihtiyaç duyar. Adresi de yapıştırabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quét QR cần quyền truy cập vào máy ảnh trên iPhone được hỗ trợ. Bạn cũng có thể dán địa chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
