    "Connect to a node and finish syncing before sending.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اتصل بعقدة وأكمل المزامنة قبل الإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি নোডের সাথে সংযোগ করুন এবং পাঠানোর আগে সিঙ্ক করা শেষ করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stellen Sie eine Verbindung zu einem Knoten her und schließen Sie die Synchronisierung ab, bevor Sie senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conéctese a un nodo y finalice la sincronización antes de enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous à un nœud et terminez la synchronisation avant l'envoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक नोड से कनेक्ट करें और भेजने से पहले सिंकिंग समाप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hubungkan ke node dan selesaikan sinkronisasi sebelum mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connettiti a un nodo e completa la sincronizzazione prima dell'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ノードに接続し、送信する前に同期を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "노드에 연결하고 전송하기 전에 동기화를 완료하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sambung ke nod dan selesaikan penyegerakan sebelum menghantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maak verbinding met een knooppunt en voltooi de synchronisatie voordat u verzendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Połącz się z węzłem i zakończ synchronizację przed wysłaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conecte-se a um nó e conclua a sincronização antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подключитесь к узлу и завершите синхронизацию перед отправкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anslut till en nod och avsluta synkroniseringen innan du skickar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unganisha kwenye nodi na umalize kusawazisha kabla ya kutuma."
          }
        },
