    "Compare this primary address with your original wallet before finishing. A different passphrase or derivation can open a different wallet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قارن هذا العنوان الأساسي بمحفظتك الأصلية قبل الانتهاء. يمكن لعبارة مرور أو اشتقاق مختلف فتح محفظة مختلفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শেষ করার আগে আপনার আসল ওয়ালেটের সাথে এই প্রাথমিক ঠিকানাটির তুলনা করুন। একটি ভিন্ন পাসফ্রেজ বা ডেরিভেশন একটি ভিন্ন ওয়ালেট খুলতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergleichen Sie diese primäre Adresse mit Ihrem ursprünglichen Wallet, bevor Sie den Vorgang abschließen. Eine andere Passphrase oder Ableitung kann eine andere Wallet öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compare esta dirección principal con su billetera original antes de terminar. Una frase de contraseña o derivación diferente puede abrir una billetera diferente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comparez cette adresse principale avec votre portefeuille d'origine avant de terminer. Une phrase secrète ou une dérivation différente peut ouvrir un portefeuille différent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "समाप्त करने से पहले इस प्राथमिक पते की तुलना अपने मूल बटुए से करें। एक अलग पासफ़्रेज़ या व्युत्पत्ति एक अलग वॉलेट खोल सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bandingkan alamat utama ini dengan dompet asli Anda sebelum menyelesaikannya. Frasa sandi atau derivasi yang berbeda dapat membuka dompet yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confronta questo indirizzo principale con il tuo portafoglio originale prima di finire. Una passphrase o una derivazione diversa possono aprire un portafoglio diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終了する前に、このプライマリアドレスを元のウォレットと比較してください。別のパスフレーズまたは派生によって別のウォレットを開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "완료하기 전에 이 기본 주소를 원래 지갑과 비교하세요. 다른 암호나 파생어를 사용하면 다른 지갑을 열 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bandingkan alamat utama ini dengan dompet asal anda sebelum selesai. Ungkapan laluan atau terbitan yang berbeza boleh membuka dompet yang berbeza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vergelijk dit primaire adres met uw originele portemonnee voordat u klaar bent. Een andere wachtwoordzin of afleiding kan een andere portemonnee openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przed zakończeniem porównaj ten adres główny z oryginalnym portfelem. Inne hasło lub wyprowadzenie może otworzyć inny portfel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compare este endereço principal com sua carteira original antes de terminar. Uma senha ou derivação diferente pode abrir uma carteira diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прежде чем закончить, сравните этот основной адрес с исходным адресом вашего кошелька. Другая парольная фраза или ее производная версия могут открыть другой кошелек."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jämför den här primära adressen med din ursprungliga plånbok innan du avslutar. En annan lösenfras eller härledning kan öppna en annan plånbok."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Linganisha anwani hii msingi na pochi yako halisi kabla ya kumaliza. Nenosiri tofauti au derivation inaweza kufungua pochi tofauti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปรียบเทียบที่อยู่หลักนี้กับกระเป๋าเงินเดิมของคุณก่อนดำเนินการเสร็จสิ้น ข้อความรหัสผ่านหรือที่มาที่แตกต่างกันสามารถเปิดกระเป๋าเงินอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bitirmeden önce bu birincil adresi orijinal cüzdanınızla karşılaştırın. Farklı bir parola veya türetme, farklı bir cüzdan açabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "So sánh địa chỉ chính này với ví gốc của bạn trước khi hoàn tất. Một cụm mật khẩu hoặc nguồn gốc khác có thể mở một ví khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在完成之前，将此主要地址与您的原始钱包进行比较。不同的密码或派生可以打开不同的钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在完成之前，請將此主要地址與您的原始錢包進行比較。不同的密碼或派生可以打開不同的錢包。"
          }
        }
      }
    },
