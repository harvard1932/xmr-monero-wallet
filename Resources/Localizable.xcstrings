    "Keep the original passphrase separately. Both the words and passphrase are needed for recovery.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احتفظ بعبارة المرور الأصلية بشكل منفصل. هناك حاجة إلى كل من الكلمات وعبارة المرور من أجل الاسترداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মূল পাসফ্রেজ আলাদাভাবে রাখুন। পুনরুদ্ধারের জন্য শব্দ এবং পাসফ্রেজ উভয়ই প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewahren Sie die Original-Passphrase separat auf. Für die Wiederherstellung werden sowohl die Wörter als auch die Passphrase benötigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenga la frase de contraseña original por separado. Tanto las palabras como la frase de contraseña son necesarias para la recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conservez la phrase secrète originale séparément. Les mots et la phrase secrète sont nécessaires à la récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मूल पासफ़्रेज़ को अलग रखें. पुनर्प्राप्ति के लिए शब्द और पासफ़्रेज़ दोनों की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simpan frasa sandi asli secara terpisah. Baik kata maupun frasa sandi diperlukan untuk pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conserva la passphrase originale separatamente. Sia le parole che la passphrase sono necessarie per il ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元のパスフレーズは別に保管してください。回復には単語とパスフレーズの両方が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "원래 암호를 별도로 보관하십시오. 복구에는 단어와 암호가 모두 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Simpan frasa laluan asal secara berasingan. Kedua-dua perkataan dan frasa laluan diperlukan untuk pemulihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewaar de originele wachtwoordzin apart. Zowel de woorden als de wachtwoordzin zijn nodig voor herstel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zachowaj oryginalne hasło osobno. Do odzyskania potrzebne są zarówno słowa, jak i hasło."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha a senha original separadamente. Tanto as palavras quanto a senha são necessárias para a recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сохраните исходную фразу-пароль отдельно. Для восстановления необходимы как слова, так и парольная фраза."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Behåll den ursprungliga lösenfrasen separat. Både orden och lösenordsfrasen behövs för återställning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weka kaulisiri asili kando. Maneno na kaulisiri zote zinahitajika kwa urejeshaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เก็บข้อความรหัสผ่านเดิมแยกกัน ต้องใช้ทั้งคำและข้อความรหัสผ่านในการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orijinal parolayı ayrı tutun. Kurtarma için hem kelimelere hem de parolaya ihtiyaç vardır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Giữ riêng cụm mật khẩu ban đầu. Cả từ và cụm mật khẩu đều cần thiết để khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "单独保存原始密码。恢复时需要单词和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "單獨保存原始密碼。恢復時需要單字和密碼。"
          }
        }
      }
    },
    "Keep these words in order on paper. Anyone with this phrase can spend your Monero.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب هذه الكلمات بالترتيب على ورقة. يمكن لأي شخص يعرف العبارة إنفاق رصيد مونيرو الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দগুলো ক্রমানুসারে কাগজে লিখে রাখুন। এই শব্দগুলো জানলে যে কেউ আপনার Monero খরচ করতে পারবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe diese Wörter in der richtigen Reihenfolge auf Papier. Wer die Wörter kennt, kann deine Monero ausgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota estas palabras en orden en un papel. Cualquier persona que conozca la frase puede gastar tus moneros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez ces mots dans l’ordre sur du papier. Toute personne qui connaît cette phrase peut dépenser vos moneros."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन शब्दों को इसी क्रम में कागज़ पर लिखें। जिसे भी यह वाक्यांश पता है, वह आपके Monero खर्च कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis kata-kata ini secara berurutan di atas kertas. Siapa pun yang mengetahui frasa ini dapat membelanjakan Monero Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi queste parole su carta nell’ordine indicato. Chiunque conosca la frase può spendere i tuoi monero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語を表示された順番で紙に書き留めてください。このフレーズを知っていれば、誰でもあなたのMoneroを送金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들을 순서대로 종이에 적으세요. 이 문구를 아는 사람은 누구나 내 모네로를 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis perkataan ini mengikut urutan di atas kertas. Sesiapa yang mengetahui frasa ini boleh membelanjakan Monero anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf deze woorden in de juiste volgorde op papier. Iedereen die de herstelzin kent, kan je monero uitgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz te słowa na papierze w podanej kolejności. Każdy, kto zna tę frazę, może wydać Twoje monero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote estas palavras em ordem em um papel. Qualquer pessoa que conheça a frase pode gastar seus moneros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите эти слова на бумаге по порядку. Любой, кто знает эту фразу, может потратить ваши монеты Monero."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Håll ordning på dessa ord på papper. Alla med den här frasen kan spendera din Monero."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika maneno haya kwenye karatasi kwa mpangilio wake. Mtu yeyote anayejua maneno haya anaweza kutumia Monero zako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดคำเหล่านี้ลงบนกระดาษตามลำดับ ผู้ใดที่รู้วลีนี้จะสามารถใช้จ่าย Monero ของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeleri sırasıyla kâğıda yazın. Bu ifadeyi bilen herkes Monero’nuzu harcayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi những từ này ra giấy theo đúng thứ tự. Bất kỳ ai biết cụm từ này đều có thể chi tiêu Monero của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这些词按顺序写在纸上。任何知道这组助记词的人都能花费你的门罗币。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將這些詞依序寫在紙上。任何知道這組助記詞的人都能花用你的門羅幣。"
          }
        }
      }
    },
