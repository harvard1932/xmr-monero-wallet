# The cached dependency libraries target the selected arm64 Apple ABI.
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT "$ENV{MONERO_APPLE_SDK}")
set(CMAKE_OSX_DEPLOYMENT_TARGET 17.0)
set(prefix "$ENV{MONERO_APPLE_PREFIX}")
set(CMAKE_FIND_ROOT_PATH "${prefix}" "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_PREFIX_PATH "${prefix}")
set(CMAKE_C_COMPILER "$ENV{MONERO_APPLE_CC}")
set(CMAKE_CXX_COMPILER "$ENV{MONERO_APPLE_CXX}")
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(CMAKE_POLICY_DEFAULT_CMP0167 OLD)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Avoid using libraries installed for the host Mac.
set(OPENSSL_ROOT_DIR "${prefix}")
set(OPENSSL_USE_STATIC_LIBS ON)
set(OPENSSL_INCLUDE_DIR "${prefix}/include" CACHE PATH "")
set(OPENSSL_CRYPTO_LIBRARY "${prefix}/lib/libcrypto.a" CACHE FILEPATH "")
set(OPENSSL_SSL_LIBRARY "${prefix}/lib/libssl.a" CACHE FILEPATH "")
set(Boost_NO_BOOST_CMAKE ON)
set(Boost_USE_STATIC_LIBS ON)
set(Boost_USE_STATIC_RUNTIME OFF)
set(BOOST_ROOT "${prefix}")
set(Boost_INCLUDE_DIR "${prefix}/include" CACHE PATH "")
foreach(component filesystem thread date_time chrono serialization program_options locale atomic regex)
    string(TOUPPER "${component}" key)
    foreach(config RELEASE DEBUG)
        set(Boost_${key}_LIBRARY_${config} "${prefix}/lib/libboost_${component}.a" CACHE FILEPATH "")
    endforeach()
endforeach()
set(UNBOUND_INCLUDE_DIR "${prefix}/include")
set(UNBOUND_LIBRARIES "${prefix}/lib/libunbound.a")
set(SODIUM_INCLUDE_DIR "${prefix}/include")
set(SODIUM_LIBRARY "${prefix}/lib/libsodium.a")
set(ZMQ_INCLUDE_PATH "${prefix}/include")
set(ZMQ_LIB "${prefix}/lib/libzmq.a")
set(MANUAL_SUBMODULES ON)
set(HIDAPI_DUMMY ON)
set(ARCH armv8-a)
set(ARM8 ON)
set(BUILD_64 ON)
set(BUILD_TAG ios-armv8)
